---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Cartouche from '../components/Cartouche.astro';
import { AHREFS_CLE, CONTACT, GA_MESURE, MARQUE } from '../consts';
/*
  Préchargement de la fonte. Sans lui, le basculement depuis la police système
  décale la mise en page au chargement : 0,083 de CLS mesuré sur /expertises.
*/
import archivo from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';

interface Props {
  /** Sans le suffixe « | sabi&co », ajouté ici. 60 caractères maximum au total. */
  titre: string;
  /** 155 caractères maximum. Unique pour chaque page. */
  description: string;
  /** Ajoute les données structurées ProfessionalService. Accueil uniquement. */
  donneesStructurees?: boolean;
  /** Retire la page des moteurs. Pages légales. */
  noindex?: boolean;
  /**
   * Données structurées supplémentaires, propres à la page. Le bloc
   * `ProfessionalService` du cabinet reste sur l'accueil ; ici on ajoute ce
   * que la page décrit vraiment : un service, une FAQ, un terme défini, un
   * fil d'ariane. Chaque objet est émis dans son propre script.
   */
  schemas?: Record<string, unknown>[];
}

const {
  titre,
  description,
  donneesStructurees = false,
  noindex = false,
  schemas = [],
} = Astro.props;

const titreComplet = `${titre} | ${MARQUE}`;

/*
  Le build sort des fichiers .html mais les pages sont servies sans extension,
  et c'est cette forme que reprennent le sitemap et tous les liens internes.
  L'URL canonique doit être la même, sinon elle contredit le sitemap.
*/
const cheminBrut = Astro.url.pathname.replace(/index\.html$/, '/').replace(/\.html$/, '');
const chemin = cheminBrut === '' || cheminBrut === '/' ? '/' : cheminBrut.replace(/\/$/, '');
const canonical = new URL(chemin, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: MARQUE,
  description:
    "Cabinet indépendant à Paris. Stratégie, structuration, développement et direction financière à temps partagé.",
  knowsAbout: [
    'Conseil en stratégie',
    'Structuration de groupe',
    'Développement et croissance externe',
    'Direction financière à temps partagé',
    'Financement dilutif et non dilutif',
    'Subventions et aides publiques',
  ],
  url: Astro.site!.href,
  email: CONTACT.email,
  areaServed: CONTACT.pays,
  address: {
    '@type': 'PostalAddress',
    addressLocality: CONTACT.ville,
    addressCountry: 'FR',
    // TODO mentions légales : ajouter streetAddress et postalCode une fois l'adresse arrêtée.
  },
  sameAs: [CONTACT.linkedin],
};
---

<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={MARQUE} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sabi&co, structurer et financer la croissance" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={archivo} crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14263D" />

    {
      donneesStructurees && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {
      schemas.map((s) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }

    {/* Les deux domaines de mesure sont contactés dès la première peinture.
        Ouvrir la connexion en avance économise la résolution et la poignée
        de main sur le chemin critique. */}
    <link rel="preconnect" href="https://analytics.ahrefs.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    {/*
      Google Analytics 4.

      La balise fournie par Google charge `gtag.js` tout de suite : 172 Ko et
      143 ms de blocage mesurés, soit quatre points de performance perdus.

      Le comportement est conservé, le calendrier change. La file `dataLayer`
      et l'appel `config` sont posés en ligne, donc la visite est horodatée à
      l'instant juste. La bibliothèque, elle, arrive au premier temps mort ou
      au premier geste du visiteur, selon ce qui vient en premier. Elle vide
      alors la file, et la visite remonte avec sa vraie heure.

      Contrairement à Ahrefs, GA4 dépose des cookies et transmet à Google. Un
      bandeau de consentement est légalement requis en France pour le charger.
      Le site n'en a pas : le point est signalé au client et consigné dans
      PRODUCT.md.
    */}
    {
      GA_MESURE && (
        <script is:inline define:vars={{ GA_MESURE }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', GA_MESURE);

          (function () {
            var pose = false;
            function poser() {
              if (pose) return;
              pose = true;
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MESURE;
              document.head.appendChild(s);
            }
            var gestes = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
            gestes.forEach(function (g) {
              addEventListener(g, poser, { once: true, passive: true });
            });
            if ('requestIdleCallback' in window) {
              requestIdleCallback(poser, { timeout: 3000 });
            } else {
              setTimeout(poser, 2200);
            }
          })();
        </script>
      )
    }

    {/*
      Mesure d'audience Ahrefs. Sans cookie, sans donnée personnelle, donc sans
      bandeau de consentement. Chargée en `async` : elle ne retarde ni le rendu
      ni la première peinture.
    */}
    {
      AHREFS_CLE && (
        <script
          is:inline
          src="https://analytics.ahrefs.com/analytics.js"
          data-key={AHREFS_CLE}
          async
        />
      )
    }

    {/*
      La classe est posée avant la peinture. Toute la mise en scène du
      mouvement est conditionnée à elle : sans JavaScript, rien n'est caché.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Filet de sécurité : si le module ne s'annonce pas, tout redevient visible.
      setTimeout(function () {
        var r = document.documentElement;
        if (!r.classList.contains('anime')) r.classList.add('mouvement-abandon');
      }, 2600);
    </script>
  </head>

  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-encre focus:text-papier focus:px-4 focus:py-3 focus:text-corps"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu">
      <slot />
    </main>

    <Cartouche />

    {/*
      Le mouvement arrive au premier temps mort, ou au premier geste.

      Tant que le titre du premier écran dépendait de GSAP, il fallait charger
      la bibliothèque tout de suite. Ce n'est plus le cas : le titre se lève
      par la feuille de style. Les 53 Ko de GSAP peuvent donc quitter le
      chemin critique, puisque tout ce qu'ils animent est sous la ligne de
      flottaison ou lié au défilement.

      Le filet de `Base` reste en place : si le module ne s'annonce pas en
      2,6 s, la classe `mouvement-abandon` rend visible ce que la feuille de
      style avait caché.
    */}
    <script>
      const charger = () => import('../scripts/mouvement');
      let lance = false;
      const une = () => {
        if (lance) return;
        lance = true;
        charger();
      };
      for (const geste of ['pointerdown', 'keydown', 'scroll', 'touchstart']) {
        addEventListener(geste, une, { once: true, passive: true });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(une, { timeout: 2600 });
      } else {
        setTimeout(une, 1200);
      }
    </script>
  </body>
</html>
