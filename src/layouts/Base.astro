---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Cartouche from '../components/Cartouche.astro';
import { CONTACT, MARQUE } from '../consts';
/*
  Préchargement de la fonte. Sans lui, le basculement depuis la police système
  décale la mise en page au chargement : 0,083 de CLS mesuré sur /expertises.
*/
import archivo from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';

interface Props {
  /** Sans le suffixe « | sabi&co », ajouté ici. 60 caractères maximum au total. */
  titre: string;
  /** 155 caractères maximum. Unique pour chaque page. */
  description: string;
  /** Ajoute les données structurées ProfessionalService. Accueil uniquement. */
  donneesStructurees?: boolean;
  /** Retire la page des moteurs. Pages légales. */
  noindex?: boolean;
}

const {
  titre,
  description,
  donneesStructurees = false,
  noindex = false,
} = Astro.props;

const titreComplet = `${titre} | ${MARQUE}`;

/*
  Le build sort des fichiers .html mais les pages sont servies sans extension,
  et c'est cette forme que reprennent le sitemap et tous les liens internes.
  L'URL canonique doit être la même, sinon elle contredit le sitemap.
*/
const cheminBrut = Astro.url.pathname.replace(/index\.html$/, '/').replace(/\.html$/, '');
const chemin = cheminBrut === '' || cheminBrut === '/' ? '/' : cheminBrut.replace(/\/$/, '');
const canonical = new URL(chemin, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: MARQUE,
  description: 'Cabinet de direction financière à temps partagé. Structurer et financer la croissance.',
  url: Astro.site!.href,
  email: CONTACT.email,
  telephone: CONTACT.telephone,
  areaServed: CONTACT.pays,
  address: {
    '@type': 'PostalAddress',
    addressLocality: CONTACT.ville,
    addressCountry: 'FR',
    // TODO mentions légales : ajouter streetAddress et postalCode une fois l'adresse arrêtée.
  },
  founder: {
    '@type': 'Person',
    name: 'Sacha Bitoun',
  },
  sameAs: [CONTACT.linkedin],
};
---

<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={MARQUE} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sabi&co, structurer et financer la croissance" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={archivo} crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14263D" />

    {
      donneesStructurees && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {/*
      TODO analytics : brancher Plausible ou Umami une fois le domaine actif.
      Aucun cookie déposé par ces deux outils, donc aucun bandeau de consentement.
      Exemple : <script defer data-domain="sabi-co.fr" src="https://plausible.io/js/script.js" />
    */}

  </head>

  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-encre focus:text-papier focus:px-4 focus:py-3 focus:text-corps"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu">
      <slot />
    </main>

    <Cartouche />

  </body>
</html>
