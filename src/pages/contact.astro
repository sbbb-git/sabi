---
import Base from '../layouts/Base.astro';
import EnTetePlanche from '../components/EnTetePlanche.astro';
import FilAriane from '../components/FilAriane.astro';
import { filAriane } from '../lib/schema';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT } from '../consts';

const moyens = [
  {
    surtitre: 'Écrire',
    valeur: CONTACT.email,
    href: `mailto:${CONTACT.email}`,
    externe: false,
  },
  {
    surtitre: 'Suivre',
    valeur: 'LinkedIn',
    href: CONTACT.linkedin,
    externe: true,
  },
];

const maillons = [{ libelle: 'Accueil', href: '/' }, { libelle: 'Contact' }];
---

<Base
  titre="Contact"
  description="Parlons de votre projet. Écrivez au cabinet pour exposer votre situation, vos enjeux de stratégie, de structuration ou de financement."

  schemas={[filAriane(maillons)]}
>
  <FilAriane maillons={maillons} />

  <EnTetePlanche
    rubrique="Contact"
    titre="Parlons de votre projet."
    objet="Une stratégie à chiffrer, une organisation à revoir, un financement à monter. Dites-nous où vous en êtes, nous vous dirons où nous pouvons intervenir."
  />

  <section class="pt-16 pb-20 lg:pt-24 lg:pb-24">
    <div class="planche">
      <ul class="grid border-t border-encre md:grid-cols-2">
        {
          moyens.map((moyen) => (
            <li class="border-b border-tirage-pale pt-7 pb-9 md:pr-8">
              <p class="cote">{moyen.surtitre}</p>
              <a
                href={moyen.href}
                target={moyen.externe ? '_blank' : undefined}
                rel={moyen.externe ? 'noopener noreferrer nofollow' : undefined}
                class="titre-rubrique mt-4 inline-block underline decoration-tirage-pale decoration-1 underline-offset-[0.3em] transition-colors duration-150 hover:text-tirage hover:decoration-tirage"
              >
                {moyen.valeur}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pb-24 lg:pb-32">
    <div class="planche">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4">
          <p class="cote">Formulaire</p>
        </div>
        <div class="lg:col-span-8">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Base>
