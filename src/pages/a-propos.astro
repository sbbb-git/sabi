---
import Base from '../layouts/Base.astro';
import EnTetePlanche from '../components/EnTetePlanche.astro';
import FilAriane from '../components/FilAriane.astro';
import { filAriane } from '../lib/schema';

const maillons = [{ libelle: 'Accueil', href: '/' }, { libelle: 'À propos' }];
---

<Base
  titre="À propos"
  description="Cabinet indépendant à Paris. Stratégie, structuration, développement et direction financière à temps partagé, avec des méthodes éprouvées en interne."

  schemas={[filAriane(maillons)]}
>
  <FilAriane maillons={maillons} />

  <EnTetePlanche
    rubrique="Le cabinet"
    titre="Un cabinet indépendant, fondé sur cinq ans de terrain"
    objet="Stratégie, structuration, développement et finance. Les méthodes ont d'abord été éprouvées en interne, à la direction d'un groupe multi-sites."
  />

  <section class="cartouche">
    <div class="planche py-16 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3"><span class="ligne-cote mt-4 block w-20" aria-hidden="true"></span></div>
        <p class="max-w-[32ch] text-[1.375rem] leading-[1.25] font-semibold tracking-[-0.02em] lg:col-span-9 lg:text-[2rem]" style="font-stretch:88%">
          Les plans ont été écrits et les dossiers montés depuis l'intérieur d'une entreprise. sabi&amp;co vous dit ce qui tient devant un conseil ou un comité de crédit. Et ce qui ne tient pas.
        </p>
      </div>
    </div>
  </section>
</Base>
