---
import Base from '../layouts/Base.astro';
import EnTetePlanche from '../components/EnTetePlanche.astro';
---

<Base
  titre="À propos"
  description="Un cabinet indépendant fondé sur cinq ans de direction financière et de développement dans un groupe de santé multi-sites."
>
  <EnTetePlanche
    rubrique="Rubrique 03 · Le cabinet"
    titre="Un cabinet indépendant, fondé sur cinq ans de terrain"
    objet="Les méthodes proposées aux clients ont d'abord été éprouvées en interne, à la direction financière et au développement d'un groupe multi-sites."
  />

  <section class="cartouche">
    <div class="planche py-16 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3"><span class="ligne-cote mt-4 block w-20" aria-hidden="true"></span></div>
        <p class="max-w-[32ch] text-[1.375rem] leading-[1.25] font-semibold tracking-[-0.02em] lg:col-span-9 lg:text-[2rem]" style="font-stretch:88%">
          Les dossiers ont été montés depuis l'intérieur d'une entreprise. sabi&amp;co vous dit ce qui passe devant un comité de crédit et ce qui ne passe pas.
        </p>
      </div>
    </div>
  </section>
</Base>
