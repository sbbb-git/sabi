---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import DarkBand from '../components/DarkBand.astro';
import { CONTACT } from '../consts';
import { CHIFFRES, FONDATEUR } from '../data/contenu';
---

<Base
  titre="À propos"
  description="Un cabinet indépendant fondé sur cinq ans de direction financière et de développement dans un groupe de santé multi-sites."
>
  <Masthead
    surtitre="Le cabinet"
    titre="Un cabinet indépendant, fondé sur cinq ans de terrain"
    phrase="Les méthodes proposées aux clients ont d'abord été éprouvées en interne, à la direction financière et au développement d'un groupe de santé multi-sites mené de 3 à 13 centres en 5 ans."
  />

  {/* Chiffres */}
  <section class="section">
    <div class="conteneur">
      <dl class="grid border-t border-bord sm:grid-cols-2 lg:grid-cols-4">
        {
          CHIFFRES.map((chiffre) => (
            <div class="reveal border-b border-bord pt-10 pb-12 sm:pr-8">
              <dt class="sr-only">{chiffre.libelle}</dt>
              <dd>
                <span class="chiffre block text-[3rem] text-nuit lg:text-[4rem]">
                  {chiffre.valeur}
                </span>
                <span class="mt-4 block max-w-[22ch] text-corps text-texte">{chiffre.libelle}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Fondateur */}
  <section class="section-serree bg-creme">
    <div class="conteneur">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4">
          <p class="surtitre reveal">Le fondateur</p>
        </div>

        <div class="reveal lg:col-span-8">
          <h2 class="titre-section">{FONDATEUR.nom}, {FONDATEUR.role}</h2>

          <ul class="mt-8 space-y-4">
            {
              FONDATEUR.formations.map((formation) => (
                <li class="filet pt-4 text-corps text-texte">{formation}</li>
              ))
            }
          </ul>

          <div class="mt-10">
            <a
              href={CONTACT.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="action action-accent"
            >
              LinkedIn
              <span class="fleche" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <DarkBand
    texte="Les dossiers ont été montés depuis l'intérieur d'une entreprise. sabi&co vous dit ce qui passe devant un comité de crédit et ce qui ne passe pas."
  />
</Base>
