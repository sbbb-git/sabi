---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import toits from '../assets/toits.jpg';
import avenue from '../assets/avenue.jpg';
import { CONTACT, RDV } from '../consts';
import { BANDE_ACCUEIL, EXPERTISES, PILIERS, QUESTIONS, REFERENCES, SITUATIONS } from '../data/contenu';

---

<Base
  titre="Structurer et financer la croissance"
  description="DAF à temps partagé à Paris. Financement bancaire, subventions publiques, M&A et structuration de groupe. Le cabinet porte vos sujets financiers."
  donneesStructurees
>
  {/* Premier écran. Aplat bleu nuit pleine largeur, la ville dedans.
      C'est la composition de sateip.fr, relevée puis traduite. */}
  <section class="relative isolate overflow-hidden bg-encre text-blanc">
    <Image
      src={toits}
      alt=""
      aria-hidden="true"
      widths={[768, 1024]}
      sizes="100vw"
      quality={62}
      class="tirage-photo absolute inset-0 -z-10 h-full w-full object-cover opacity-[0.34]"
      loading="eager"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-encre via-encre/90 to-encre/40"
      aria-hidden="true"
    ></div>

    <div class="planche pt-20 pb-24 lg:pt-28 lg:pb-32">
      <p class="cote cote-claire">Finance &middot; Développement &middot; Pilotage &amp; data</p>

      <h1 class="nom-ouvrage mt-7 max-w-[15ch] text-blanc">
        Structurer et financer la croissance.
      </h1>

      <p class="mt-8 max-w-[42ch] text-[1.0625rem] leading-[1.6] text-tirage-clair lg:text-[1.1875rem]">
        Direction financière, financement et opérations, en temps partagé.
      </p>

      <div class="mt-11 flex flex-wrap items-center gap-3">
        <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette">
          Prendre rendez-vous
        </a>
        <a href="/expertises" class="etiquette etiquette-claire">Les expertises</a>
      </div>
    </div>
  </section>

  {/* Le constat, une idée par planche. */}
  <section class="planche py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="cote">Le cabinet</p>
      </div>
      <div class="lg:col-span-9">
        <h2 class="titre-planche max-w-[24ch]">
          En grandissant, une entreprise crée des sujets que personne ne porte
          vraiment.
        </h2>
        <p class="mt-6 max-w-[54ch] text-[1.0625rem] text-graphite">
          sabi&amp;co les prend en charge, et reste jusqu'à ce qu'ils tournent seuls.
        </p>

        {/* Les cinq piliers, cotés et reliés par une ligne de rappel. */}
        <ul class="mt-12 grid gap-px border-t border-tirage-pale sm:grid-cols-2 lg:mt-16 lg:grid-cols-5">
          {
            PILIERS.map((pilier, i) => (
              <li class="border-b border-tirage-pale pt-6 pb-8 sm:pr-6">
                <span class="cote">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="titre-rubrique mt-4">{pilier.titre}</h3>
                <p class="mt-3 text-[0.9375rem] leading-[1.55] text-graphite">{pilier.phrase}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Quand un dirigeant nous appelle. Quatre situations, pas des arguments. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <h2 class="titre-planche max-w-[22ch]">Ce qui déclenche un premier appel</h2>
      <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
        Les situations changent, le point commun ne change pas : un sujet financier
        structurant est apparu, personne en interne n'a le temps ni le recul de le
        porter, et il bloque une décision.
      </p>

      <div class="mt-12 grid gap-px border-t border-tirage-pale lg:mt-16 lg:grid-cols-2">
        {
          SITUATIONS.map((s, i) => (
            <article class="border-b border-tirage-pale py-8 lg:pr-12">
              <span class="cote">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="titre-rubrique mt-4 max-w-[34ch]">{s.titre}</h3>
              <p class="mt-4 max-w-[58ch] text-[0.9375rem] leading-[1.65] text-graphite">
                {s.texte}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Bande d'intervention. La photographie porte l'aplat, l'encre reste
      lisible par dessus. */}
  <section class="cartouche relative overflow-hidden">
    <Image
      src={avenue}
      alt=""
      aria-hidden="true"
      widths={[768, 1024]}
      sizes="100vw"
      quality={52}
      class="tirage-photo absolute inset-0 h-full w-full object-cover opacity-[0.22]"
      loading="lazy"
    />
    <div class="planche relative py-20 lg:py-32">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3">
          <span class="ligne-cote mt-4 block w-20" aria-hidden="true"></span>
        </div>
        <p class="max-w-[34ch] text-[1.375rem] leading-[1.25] font-semibold tracking-[-0.02em] lg:col-span-9 lg:text-[2rem]" style="font-stretch:88%">
          {BANDE_ACCUEIL}
        </p>
      </div>
    </div>
  </section>

  {/* Les six expertises. Le recouvrement : elles se prennent séparées ou
      combinées, et la planche montre l'intersection. */}
  <section class="planche py-16 lg:py-24">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="titre-planche max-w-[20ch]">Six expertises, séparées ou combinées</h2>
        <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
          Direction financière à temps partagé, financement bancaire et non dilutif,
          subventions publiques, opérations de haut de bilan, structuration de groupe
          et pilotage par la donnée. Vous prenez ce dont vous avez besoin, au moment
          où vous en avez besoin.
        </p>
      </div>
      <a href="/expertises" class="renvoi shrink-0">
        Le détail des six
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <ol class="mt-12 border-t border-encre lg:mt-16">
      {
        EXPERTISES.map((expertise, i) => (
          <li class="group grid gap-3 border-b border-tirage-pale py-6 lg:grid-cols-12 lg:items-baseline lg:gap-10 lg:py-7">
            <div class="flex items-center gap-4 lg:col-span-1">
              <span class="repere">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="titre-rubrique lg:col-span-5">{expertise.titre}</h3>
            <p class="text-[0.9375rem] leading-[1.55] text-graphite lg:col-span-6">
              {expertise.phrase}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* Les références. Chaque objet se termine sur sa cote. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="titre-planche max-w-[20ch]">Des dossiers menés, décrits par leur objet</h2>
          <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
            Aucun nom de client, aucun témoignage de complaisance. Chaque mission est
            décrite par ce qu'elle a produit.
          </p>
        </div>
        <a href="/references" class="renvoi shrink-0">
          Toutes les missions
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="mt-12 border-t border-encre lg:mt-16">
        {
          REFERENCES.map((ref) => (
            <article class="grid gap-2 border-b border-tirage-pale py-7 lg:grid-cols-12 lg:items-baseline lg:gap-10">
              <p class="cote lg:col-span-3">{ref.secteur}</p>
              <div class="lg:col-span-6">
                <h3 class="titre-rubrique">{ref.objet}</h3>
                <p class="mt-3 max-w-[52ch] text-[0.9375rem] leading-[1.6] text-graphite">
                  {ref.phrase}
                </p>
              </div>
              {ref.chiffre && (
                <p class="cote cote-accent lg:col-span-3 lg:text-right">{ref.chiffre}</p>
              )}
            </article>
          ))
        }
      </div>

      <p class="mt-14 text-[1.375rem] leading-[1.15] font-semibold tracking-[-0.025em] text-tirage lg:mt-16 lg:text-[1.75rem]" style="font-stretch:86%">
        Prochaine réalisation : la vôtre.
      </p>
    </div>
  </section>

  {/* Les questions posées en premier rendez-vous. Elles servent au lecteur
      comme aux moteurs, qui piochent dedans pour répondre directement. */}
  <section class="planche py-16 lg:py-24">
    <h2 class="titre-planche max-w-[24ch]">Les questions posées en premier rendez-vous</h2>

    <dl class="mt-12 border-t border-encre lg:mt-16">
      {
        QUESTIONS.map((item) => (
          <div class="grid gap-3 border-b border-tirage-pale py-8 lg:grid-cols-12 lg:gap-10">
            <dt class="titre-rubrique lg:col-span-5">{item.q}</dt>
            <dd class="max-w-[62ch] text-[0.9375rem] leading-[1.7] text-graphite lg:col-span-7">
              {item.r}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-14 flex flex-wrap items-center gap-3">
      <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette">
        Prendre rendez-vous
      </a>
      <a href="/contact" class="etiquette etiquette-encre">Nous écrire</a>
    </div>
  </section>
</Base>
