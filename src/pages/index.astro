---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import BandePhoto from '../components/BandePhoto.astro';
import toits from '../assets/toits.jpg';
import avenue from '../assets/avenue.jpg';
import viaduc from '../assets/viaduc.jpg';
import { CONTACT, RDV } from '../consts';
import { faq } from '../lib/schema';
import { BANDE_ACCUEIL, CHIFFRES_CLES, EXPERTISES, QUESTIONS, REFERENCES, SITUATIONS, VOIES_FINANCEMENT } from '../data/contenu';

---

<Base
  titre="Structurer, financer et accompagner la croissance"
  description="Cabinet de direction financière à temps partagé à Paris. Nous accompagnons les dirigeants sur le financement, les subventions publiques et le M&A."
  donneesStructurees
  schemas={[faq(QUESTIONS)]}
>
  {/* Premier écran. Aplat bleu nuit pleine largeur, la ville dedans.
      C'est la composition de sateip.fr, relevée puis traduite. */}
  <section class="relative isolate overflow-hidden bg-encre text-blanc">
    <Image
      src={toits}
      alt=""
      aria-hidden="true"
      widths={[768, 1024]}
      sizes="100vw"
      quality={62}
      class="tirage-photo absolute inset-0 -z-10 h-full w-full object-cover opacity-[0.34]"
      loading="eager"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-encre via-encre/90 to-encre/40"
      aria-hidden="true"
    ></div>

    <div class="planche pt-20 pb-24 lg:pt-28 lg:pb-32">
      <p class="cote cote-claire">Finance · Développement · Pilotage &amp; data</p>

      <h1 class="nom-ouvrage mt-7 max-w-[17ch] text-blanc">
        Structurer, financer et accompagner la croissance.
      </h1>

      <p class="mt-8 max-w-[42ch] text-[1.0625rem] leading-[1.6] text-tirage-clair lg:text-[1.1875rem]">
        Un cabinet de direction financière à temps partagé. Nous accompagnons les
        dirigeants sur leurs sujets financiers, jusqu'à ce qu'ils tournent seuls.
      </p>

      <div class="mt-11 flex flex-wrap items-center gap-3">
        <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette">
          Prendre rendez-vous
        </a>
        <a href="/expertises" class="etiquette etiquette-claire">Les expertises</a>
      </div>
    </div>
  </section>

  {/* Les cotes de l'ouvrage. Elles se lisent avant le texte, comme le cartouche
      d'une planche donne l'échelle avant qu'on lise le dessin. Les valeurs
      viennent du portfolio, elles ne se déduisent pas. */}
  <section class="border-b border-tirage-pale bg-papier">
    <div class="planche">
      <dl class="grid grid-cols-2 lg:grid-cols-4">
        {
          CHIFFRES_CLES.map((c, i) => (
            <div
              data-rangee
              class:list={[
                'border-tirage-pale py-9 lg:py-12',
                i % 2 === 0 ? 'pr-6' : 'border-l pl-6 lg:pl-10',
                i < 2 ? 'border-b lg:border-b-0' : '',
                i === 2 ? 'lg:border-l lg:pl-10' : '',
                i > 0 && i !== 2 ? 'lg:border-l lg:pl-10' : '',
              ]}
            >
              <dd
                data-compteur
                class="text-[2.5rem] leading-[0.95] font-semibold tracking-[-0.035em] text-encre tabular-nums lg:text-[3.75rem]"
                style="font-stretch:84%"
              >
                {c.valeur}
              </dd>
              <dt class="cote mt-4 block max-w-[18ch]">{c.libelle}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Les six expertises. Le recouvrement : elles se prennent séparées ou
      combinées, et la planche montre l'intersection. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="titre-planche max-w-[20ch]">Six expertises, séparées ou combinées</h2>
          <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
            Chacune se prend seule ou avec les autres. Une direction financière
            complète, ou une seule expertise sur un projet précis.
          </p>
        </div>
        <a href="/expertises" class="renvoi shrink-0">
          Le détail des six
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ol class="mt-12 border-t border-encre lg:mt-16">
        {
          EXPERTISES.map((expertise, i) => (
            <li data-rangee class="border-b border-tirage-pale">
              <a
                href={expertise.href}
                class="group grid gap-3 py-6 lg:grid-cols-[5rem_minmax(0,1fr)_minmax(0,1.25fr)] lg:items-baseline lg:gap-10 lg:py-7"
              >
                <div class="flex items-center gap-4">
                  <span class="repere">{String(i + 1).padStart(2, '0')}</span>
                  <Icone
                    nom={expertise.icone}
                    taille={32}
                    class="text-tirage transition-transform duration-200 group-hover:-translate-y-0.5"
                  />
                </div>
                <h3 class="titre-rubrique transition-colors duration-150 group-hover:text-tirage">
                  {expertise.titre}
                </h3>
                <p class="text-[0.9375rem] leading-[1.55] text-graphite">
                  {expertise.phrase}
                </p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Le constat, une idée par planche. */}
  <section class="planche py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <p class="cote">Le cabinet</p>
      </div>
      <div class="lg:col-span-9">
        <h2 class="titre-planche max-w-[24ch]">
          En grandissant, une entreprise crée des sujets que personne ne porte
          vraiment.
        </h2>
        <p class="mt-6 max-w-[54ch] text-[1.0625rem] text-graphite">
          sabi&amp;co les prend en charge, et reste jusqu'à ce qu'ils tournent seuls.
        </p>

        {/* Les cinq piliers ont été retirés : ils redisaient les six expertises,
            placées juste au-dessus, en plus vague. Récupérables dans l'historique. */}
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/expertises" class="etiquette etiquette-encre">Les six expertises</a>
          <a href="/lexique" class="etiquette etiquette-encre">Le lexique</a>
        </div>
      </div>
    </div>
  </section>

  {/* Quand un dirigeant nous appelle. Quatre situations, pas des arguments. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <h2 class="titre-planche max-w-[22ch]">Ce qui déclenche un premier appel</h2>
      <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
        Un sujet financier bloque une décision. Personne en interne n'a le temps
        de le porter.
      </p>

      <div class="mt-12 grid gap-px border-t border-tirage-pale lg:mt-16 lg:grid-cols-2">
        {
          SITUATIONS.map((s, i) => (
            <article data-rangee class="border-b border-tirage-pale py-8 lg:pr-12">
              <div class="flex items-center gap-3">
                <Icone nom={s.icone} taille={30} class="text-tirage" />
                <span class="cote">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="titre-rubrique mt-4 max-w-[34ch]">{s.titre}</h3>
              <p class="mt-4 max-w-[58ch] text-[0.9375rem] leading-[1.65] text-graphite">
                {s.texte}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Financer votre ambition. Les deux voies posées côte à côte : c'est le
      premier arbitrage que pose un dirigeant, et la page dédiée le développe. */}
  <section class="planche py-16 lg:py-24">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="cote">Financement</p>
        <h2 class="titre-planche mt-5 max-w-[16ch]">Financer votre ambition</h2>
        <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
          Un amorçage se finance autrement qu'une reprise. Nous couvrons les deux
          voies. L'une ouvre le capital, l'autre le laisse intact.
        </p>
      </div>
      <a href="/financement" class="renvoi shrink-0">
        Le financement en détail
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-12 grid gap-px border-t border-encre lg:mt-16 lg:grid-cols-2">
      {
        VOIES_FINANCEMENT.map((voie, i) => (
          <article
            data-rangee
            class:list={[
              'border-b border-tirage-pale py-8',
              i === 0 ? 'lg:border-r lg:pr-12' : 'lg:pl-12',
            ]}
          >
            <div class="flex items-center gap-3">
              <Icone nom={voie.icone} taille={32} class="text-tirage" />
              <span class="cote">{voie.titre}</span>
            </div>
            <p
              class="mt-5 max-w-[34ch] text-[1.25rem] leading-[1.25] font-semibold tracking-[-0.02em] text-encre lg:text-[1.5rem]"
              style="font-stretch:88%"
            >
              {voie.accroche}
            </p>
            <ul class="mt-6 space-y-2.5">
              {voie.lignes.slice(0, 4).map((ligne) => (
                <li class="flex gap-4 text-[0.9375rem] leading-[1.5] text-graphite">
                  <span class="mt-[0.55em] h-px w-4 shrink-0 bg-tirage" aria-hidden="true" />
                  <span>{ligne}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  {/* Bande d'intervention. La photographie porte l'aplat, l'encre reste
      lisible par dessus. */}
  <section class="cartouche relative overflow-hidden">
    <Image
      src={avenue}
      alt=""
      aria-hidden="true"
      widths={[768, 1024]}
      sizes="100vw"
      quality={52}
      class="tirage-photo absolute inset-0 h-full w-full object-cover opacity-[0.22]"
      loading="lazy"
    />
    <div class="planche relative py-20 lg:py-32">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3">
          <span class="ligne-cote mt-4 block w-20" aria-hidden="true"></span>
        </div>
        <p class="max-w-[34ch] text-[1.375rem] leading-[1.25] font-semibold tracking-[-0.02em] lg:col-span-9 lg:text-[2rem]" style="font-stretch:88%">
          {BANDE_ACCUEIL}
        </p>
      </div>
    </div>
  </section>

  {/* Les références. Chaque objet se termine sur sa cote. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="titre-planche max-w-[20ch]">Des dossiers menés, décrits par leur objet</h2>
          <p class="mt-6 max-w-[62ch] text-[1.0625rem] leading-[1.65] text-graphite">
            Chaque mission est décrite par son objet et par ce qu'elle a produit.
          </p>
        </div>
        <a href="/references" class="renvoi shrink-0">
          Toutes les missions
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="mt-12 border-t border-encre lg:mt-16">
        {
          REFERENCES.map((ref) => (
            <article data-rangee class="grid gap-2 border-b border-tirage-pale py-7 lg:grid-cols-12 lg:items-baseline lg:gap-10">
              <p class="cote lg:col-span-3">{ref.secteur}</p>
              <div class="lg:col-span-6">
                <h3 class="titre-rubrique">{ref.objet}</h3>
                <p class="mt-3 max-w-[52ch] text-[0.9375rem] leading-[1.6] text-graphite">
                  {ref.phrase}
                </p>
              </div>
              {ref.chiffre && (
                <p data-compteur class="cote cote-accent lg:col-span-3 lg:text-right">{ref.chiffre}</p>
              )}
            </article>
          ))
        }
      </div>

      <p class="mt-14 text-[1.375rem] leading-[1.15] font-semibold tracking-[-0.025em] text-tirage lg:mt-16 lg:text-[1.75rem]" style="font-stretch:86%">
        Prochaine réalisation : la vôtre.
      </p>
    </div>
  </section>

  <BandePhoto src={viaduc} legende="Paris · ouvrage de franchissement" hauteur="haute" fige />

  {/* Les questions posées en premier rendez-vous. Elles servent au lecteur
      comme aux moteurs, qui piochent dedans pour répondre directement. */}
  <section class="planche py-16 lg:py-24">
    <h2 class="titre-planche max-w-[24ch]">Les questions posées en premier rendez-vous</h2>

    <dl class="mt-12 border-t border-encre lg:mt-16">
      {
        QUESTIONS.map((item) => (
          <div class="grid gap-3 border-b border-tirage-pale py-8 lg:grid-cols-12 lg:gap-10">
            <dt class="titre-rubrique lg:col-span-5">{item.q}</dt>
            <dd class="max-w-[62ch] text-[0.9375rem] leading-[1.7] text-graphite lg:col-span-7">
              {item.r}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-16 border-t border-encre pt-10">
      <p class="titre-planche max-w-[20ch]">Pour enfin avoir les moyens de son ambition.</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette">
          Prendre rendez-vous
        </a>
        <a href="/contact" class="etiquette etiquette-encre">Nous écrire</a>
      </div>
    </div>
  </section>
</Base>
