---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import BandePhoto from '../components/BandePhoto.astro';
import avenue from '../assets/avenue.jpg';
import pont from '../assets/pont.jpg';
import { CONTACT, RDV, RDV_HREF } from '../consts';
import { faq } from '../lib/schema';
import { BANDE_ACCUEIL, CHIFFRES_CLES, EXPERTISES, QUESTIONS, REFERENCES, SITUATIONS, VOIES_FINANCEMENT } from '../data/contenu';

---

<Base
  titre="Stratégie, finance et développement"
  description="Cabinet de conseil et de direction financière à temps partagé, à Paris. Stratégie, structuration, financement et pilotage aux côtés des dirigeants."
  donneesStructurees
  schemas={[faq(QUESTIONS)]}
>
  {/* Premier écran. Plus de photographie : les vues disponibles faisaient
      carte postale, et aucune source libre atteignable ne rend mieux. La
      matière vient de la trame de calque, qui est le monde du site. */}
  <section class="relative isolate overflow-hidden bg-encre text-blanc">
    <div class="trame-calque absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(125%_95%_at_16%_8%,rgba(11,23,40,0.1)_0%,rgba(11,23,40,0.82)_68%)]"
      aria-hidden="true"
    >
    </div>

    {/* Les croix de repérage d'une feuille de tirage, aux quatre angles. Elles
        disent que l'écran est une planche, ce qu'un aplat seul ne dit pas. */}
    {
      [
        'top-8 left-8',
        'top-8 right-8',
        'bottom-8 left-8',
        'bottom-8 right-8',
      ].map((pos) => (
        <span
          class:list={['pointer-events-none absolute -z-10 block h-7 w-7 opacity-50', pos]}
          aria-hidden="true"
        >
          <span class="absolute top-1/2 left-0 block h-px w-full bg-tirage-clair" />
          <span class="absolute top-0 left-1/2 block h-full w-px bg-tirage-clair" />
        </span>
      ))
    }

    <div class="planche pt-20 pb-24 lg:pt-28 lg:pb-32">
      <p class="cote cote-claire">Stratégie &middot; Finance &middot; Développement</p>
      <span class="ligne-cote mt-6 block w-28" aria-hidden="true"></span>

      <h1 class="nom-ouvrage mt-8 max-w-[17ch] text-blanc">
        Structurer, financer et accompagner la croissance.
      </h1>

      <p class="mt-8 max-w-[44ch] text-[1.0625rem] leading-[1.6] text-tirage-clair lg:text-[1.1875rem]">
        Nous accompagnons les dirigeants sur leurs sujets de stratégie, de
        finance et de développement.
      </p>

      <div class="mt-11 flex flex-wrap items-center gap-3">
        <a href={RDV_HREF} class="etiquette">{RDV}</a>
        <a href="/expertises" class="etiquette etiquette-claire">Les expertises</a>
      </div>
    </div>
  </section>

  {/* Les cotes de l'ouvrage. Elles se lisent avant le texte, comme le cartouche
      d'une planche donne l'échelle avant qu'on lise le dessin. Les valeurs
      viennent du portfolio, elles ne se déduisent pas. */}
  <section class="border-b border-tirage-pale bg-papier">
    <div class="planche">
      <dl class="grid sm:grid-cols-3">
        {
          CHIFFRES_CLES.map((c, i) => (
            <div
              data-rangee
              class:list={[
                'border-tirage-pale py-9 lg:py-12',
                i > 0 ? 'border-t sm:border-t-0 sm:border-l sm:pl-6 lg:pl-10' : '',
                i < 2 ? 'pr-6' : '',
              ]}
            >
              <dd
                data-compteur
                class="text-[2.5rem] leading-[0.95] font-semibold tracking-[-0.035em] text-encre tabular-nums lg:text-[3.75rem]"
                style="font-stretch:84%"
              >
                {c.valeur}
              </dd>
              <dt class="cote mt-4 block max-w-[18ch]">{c.libelle}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Six expertises, en deux lignes de trois. La grille demandée par le
      client : on les embrasse d'un regard au lieu de les lire une par une. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <h2 class="titre-planche max-w-[14ch]">Six expertises</h2>
        <a href="/expertises" class="renvoi shrink-0">
          Le détail des six
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ul class="mt-12 grid gap-px border-t border-encre sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          EXPERTISES.map((expertise, i) => (
            <li
              data-rangee
              class:list={[
                'border-b border-tirage-pale',
                i % 3 !== 0 ? 'lg:border-l' : '',
                i % 2 !== 0 ? 'sm:border-l lg:border-l-0' : '',
                i % 3 !== 0 ? 'lg:border-l' : '',
              ]}
            >
              <a href={expertise.href} class="group block h-full px-0 py-8 sm:px-7 lg:px-8">
                <div class="flex items-center gap-4">
                  <span class="repere">{String(i + 1).padStart(2, '0')}</span>
                  <Icone
                    nom={expertise.icone}
                    taille={34}
                    class="text-tirage transition-transform duration-200 group-hover:-translate-y-0.5"
                  />
                </div>
                <h3 class="titre-rubrique mt-6 max-w-[20ch] transition-colors duration-150 group-hover:text-tirage">
                  {expertise.titre}
                </h3>
                <p class="mt-3 max-w-[38ch] text-[0.9375rem] leading-[1.6] text-graphite">
                  {expertise.phrase}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Pourquoi on nous appelle. Des situations, pas des arguments. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <h2 class="titre-planche max-w-[22ch]">Pourquoi faire appel à sabi&amp;co ?</h2>

      <div class="mt-10 grid gap-px border-t border-tirage-pale lg:mt-14 lg:grid-cols-2">
        {
          SITUATIONS.map((s, i) => (
            <article data-rangee class="border-b border-tirage-pale py-8 lg:pr-12">
              <div class="flex items-center gap-3">
                <Icone nom={s.icone} taille={30} class="text-tirage" />
                <span class="cote">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="titre-rubrique mt-4 max-w-[34ch]">{s.titre}</h3>
              <p class="mt-4 max-w-[58ch] text-[0.9375rem] leading-[1.65] text-graphite">
                {s.texte}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Bande d'intervention. La photographie porte l'aplat, l'encre reste
      lisible par dessus. */}
  <section class="cartouche relative overflow-hidden">
    <Image
      src={avenue}
      alt=""
      aria-hidden="true"
      widths={[768, 1024]}
      sizes="100vw"
      quality={52}
      class="tirage-photo absolute inset-0 h-full w-full object-cover opacity-[0.22]"
      loading="lazy"
    />
    <div class="planche relative py-20 lg:py-32">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3">
          <span class="ligne-cote mt-4 block w-20" aria-hidden="true"></span>
        </div>
        <p class="max-w-[34ch] text-[1.375rem] leading-[1.25] font-semibold tracking-[-0.02em] lg:col-span-9 lg:text-[2rem]" style="font-stretch:88%">
          {BANDE_ACCUEIL}
        </p>
      </div>
    </div>
  </section>


  <BandePhoto
    src={pont}
    legende="Ouvrage de franchissement sur la Seine"
    hauteur="haute"
    fige
    titre="Nos réalisations"
    lien={{ libelle: 'Voir les missions conduites', href: '/references' }}
  />

  {/* Les questions posées en premier rendez-vous. Elles servent au lecteur
      comme aux moteurs, qui piochent dedans pour répondre directement. */}
  <section class="planche py-16 lg:py-24">
    <h2 class="titre-planche max-w-[24ch]">Les questions posées en premier rendez-vous</h2>

    <dl class="mt-12 border-t border-encre lg:mt-16">
      {
        QUESTIONS.map((item) => (
          <div class="grid gap-3 border-b border-tirage-pale py-8 lg:grid-cols-12 lg:gap-10">
            <dt class="titre-rubrique lg:col-span-5">{item.q}</dt>
            <dd class="max-w-[62ch] text-[0.9375rem] leading-[1.7] text-graphite lg:col-span-7">
              {item.r}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-16 border-t border-encre pt-10">
      <p class="titre-planche max-w-[22ch]">Un sujet à mettre à plat ?</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={RDV_HREF} class="etiquette">{RDV}</a>
        <a href={`mailto:${CONTACT.email}`} class="etiquette etiquette-encre">{CONTACT.email}</a>
      </div>
    </div>
  </section>
</Base>
