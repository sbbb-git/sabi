---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import DarkBand from '../components/DarkBand.astro';
import ExpertiseCard from '../components/ExpertiseCard.astro';
import ReferenceRow from '../components/ReferenceRow.astro';
import { CONTACT, RDV } from '../consts';
import { BANDE_ACCUEIL, EXPERTISES, PILIERS, REFERENCES } from '../data/contenu';

const apercuReferences = REFERENCES.slice(0, 3);
---

<Base
  titre="Structurer et financer la croissance"
  description="Direction financière, financement et opérations, en temps partagé. Le cabinet prend en charge les sujets financiers que personne ne porte."
  donneesStructurees
>
  <Hero
    titre="Structurer et financer la croissance."
    phrase="Direction financière, financement et opérations, en temps partagé."
  >
    <a
      slot="actions"
      href={CONTACT.calendly}
      target="_blank"
      rel="noopener noreferrer"
      class="bouton"
    >
      {RDV}
      <span aria-hidden="true">&rarr;</span>
    </a>
    <a slot="actions" href="/expertises" class="bouton-contour">
      Découvrir nos expertises
      <span aria-hidden="true">&rarr;</span>
    </a>
  </Hero>

  {/* Qui sommes-nous */}
  <section class="section">
    <div class="conteneur">
      <SectionTitle
        surtitre="Le cabinet"
        titre="En grandissant, une entreprise crée des sujets que personne ne porte vraiment."
        phrase="sabi&co les prend en charge, et reste jusqu'à ce qu'ils tournent seuls."
      />

      <ul class="mt-16 grid border-t border-bord sm:grid-cols-2 lg:mt-24 lg:grid-cols-5">
        {
          PILIERS.map((pilier) => (
            <li class="reveal border-b border-bord pt-8 pb-10 sm:pr-8">
              <h3 class="font-titre text-[1.375rem] leading-[1.2] text-nuit">{pilier.titre}</h3>
              <p class="mt-3 text-corps text-texte">{pilier.phrase}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <DarkBand texte={BANDE_ACCUEIL} />

  {/* Aperçu des expertises */}
  <section class="section bg-creme">
    <div class="conteneur">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <SectionTitle
          surtitre="L'offre"
          titre="Six expertises, séparées ou combinées"
          class="lg:max-w-[46ch]"
        />
        <a href="/expertises" class="action action-accent shrink-0 self-start lg:self-auto">
          Voir le détail
          <span class="fleche" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="mt-14 grid gap-px bg-bord md:grid-cols-2 lg:mt-20 lg:grid-cols-3">
        {
          EXPERTISES.map((expertise, i) => (
            <ExpertiseCard titre={expertise.titre} phrase={expertise.phrase} rang={i + 1} />
          ))
        }
      </div>
    </div>
  </section>

  {/* Aperçu des références */}
  <section class="section-serree">
    <div class="conteneur">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <SectionTitle
          surtitre="Missions conduites"
          titre="Des dossiers menés, décrits par leur objet"
          class="lg:max-w-[46ch]"
        />
        <a href="/references" class="action action-accent shrink-0 self-start lg:self-auto">
          Voir les références
          <span class="fleche" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="mt-12 lg:mt-16">
        {apercuReferences.map((ref) => <ReferenceRow {...ref} />)}
        <div class="filet" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  {/* Bloc de fin */}
  <section class="section bg-nuit">
    <div class="conteneur">
      <h2 class="titre-display titre-clair reveal max-w-[16ch]">Parlons de votre projet.</h2>
      <div class="reveal mt-12 lg:mt-16">
        <a href="/contact" class="bouton">
          Nous écrire
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
