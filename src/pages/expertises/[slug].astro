---
/**
 * Une page par expertise.
 *
 * Pourquoi elles existent. La page `/expertises` répond à « que fait ce
 * cabinet ». Ces pages-ci répondent à « savez-vous faire ceci », qui est la
 * question réelle d'un dirigeant envoyé par un prescripteur. Ce sont aussi les
 * pages qui peuvent se positionner sur une recherche précise, là où une page
 * qui liste six métiers ne se positionne sur aucun.
 */
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/FilAriane.astro';
import Icone from '../../components/Icone.astro';
import { RDV, RDV_HREF } from '../../consts';
import { PAGES_EXPERTISE } from '../../data/pages-expertise';
import { parSlugFiche } from '../../data/lexique';
import { QUESTIONS_PAGES } from '../../data/questions';
import { faq, filAriane, service } from '../../lib/schema';

export function getStaticPaths() {
  return PAGES_EXPERTISE.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const chemin = `/expertises/${page.slug}`;

const maillons = [
  { libelle: 'Accueil', href: '/' },
  { libelle: 'Expertises', href: '/expertises' },
  { libelle: page.titre },
];

const fiches = page.lexique.map(parSlugFiche).filter((f) => f !== undefined);
const autres = PAGES_EXPERTISE.filter((p) => p.slug !== page.slug);
/* Les questions qui renvoient vers cette expertise. Dérivées, jamais saisies. */
const questionsLiees = QUESTIONS_PAGES.filter((q) => q.expertise?.href === chemin);

const schemas = [
  filAriane(maillons),
  service({
    nom: page.titre,
    description: page.description,
    chemin,
    couvre: page.livrables,
  }),
  faq(page.questions),
];
---

<Base titre={page.titreMeta} description={page.description} schemas={schemas}>
  <FilAriane maillons={maillons} />

  <section class="planche pt-8 pb-14 lg:pt-10 lg:pb-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-3">
        <Icone nom={page.icone} taille={52} class="text-tirage" />
        <span class="ligne-cote mt-7 block w-24" aria-hidden="true"></span>
      </div>
      <div class="lg:col-span-9">
        <h1 class="titre-planche max-w-[20ch]" style="font-size:clamp(2.25rem,5vw,3.75rem)">
          {page.titre}
        </h1>
        <p
          class="mt-8 max-w-[46ch] text-[1.25rem] leading-[1.35] font-semibold tracking-[-0.02em] text-encre lg:text-[1.5rem]"
          style="font-stretch:88%"
        >
          {page.chapo}
        </p>
      </div>
    </div>
  </section>

  {/* Pour qui. Le visiteur doit se reconnaître avant de lire le détail. */}
  <section class="bg-papier-clair">
    <div class="planche py-14 lg:py-20">
      <h2 class="cote">Pour qui</h2>
      <ul class="mt-8 grid gap-px border-t border-tirage-pale sm:grid-cols-2">
        {
          page.pourQui.map((q) => (
            <li
              data-rangee
              class="flex gap-4 border-b border-tirage-pale py-5 pr-8 text-[1rem] leading-[1.5] text-encre"
            >
              <span class="mt-[0.6em] h-px w-4 shrink-0 bg-tirage" aria-hidden="true" />
              <span>{q}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Le développé, une idée par section. */}
  <section class="planche py-16 lg:py-24">
    <div class="border-t border-encre">
      {
        page.sections.map((bloc, i) => (
          <article
            data-rangee
            class="grid gap-5 border-b border-tirage-pale py-10 lg:grid-cols-12 lg:gap-10 lg:py-14"
          >
            <div class="lg:col-span-4">
              <span class="repere">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="titre-rubrique mt-5 max-w-[24ch]">{bloc.titre}</h2>
            </div>
            <div class="space-y-4 lg:col-span-8">
              {bloc.paragraphes.map((t) => (
                <p class="max-w-[66ch] text-[1.0625rem] leading-[1.7] text-graphite">{t}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-14 grid gap-8 lg:mt-20 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <h2 class="cote">Ce que vous recevez</h2>
      </div>
      <ul class="lg:col-span-8">
        {
          page.livrables.map((l) => (
            <li
              data-rangee
              class="flex items-start gap-3 border-b border-tirage-pale py-3.5 first:border-t"
            >
              <span class="mt-2.5 h-px w-4 shrink-0 bg-tirage" aria-hidden="true" />
              <span class="text-[0.9375rem] leading-[1.6] text-encre">{l}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Les questions. Elles servent le lecteur, et les moteurs y puisent. */}
  <section class="bg-papier-clair">
    <div class="planche py-16 lg:py-24">
      <h2 class="titre-planche max-w-[24ch]">Les questions qu'on nous pose</h2>
      <dl class="mt-12 border-t border-encre lg:mt-16">
        {
          page.questions.map((item) => (
            <div
              data-rangee
              class="grid gap-3 border-b border-tirage-pale py-8 lg:grid-cols-12 lg:gap-10"
            >
              <dt class="titre-rubrique lg:col-span-5">{item.q}</dt>
              <dd class="max-w-[62ch] text-[0.9375rem] leading-[1.7] text-graphite lg:col-span-7">
                {item.r}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Les notions du dossier, en fiches. */}
  {
    fiches.length > 0 && (
      <section class="planche py-14 lg:py-20">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <h2 class="titre-planche max-w-[22ch]">Les notions de ce dossier</h2>
          <a href="/lexique" class="renvoi shrink-0">
            Tout le lexique
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <ul class="mt-10 grid gap-px border-t border-encre lg:grid-cols-3">
          {fiches.map((f, i) => (
            <li
              data-rangee
              class:list={[
                'border-b border-tirage-pale py-7',
                i > 0 ? 'lg:border-l lg:pl-8' : 'lg:pr-8',
              ]}
            >
              <a href={`/lexique/${f.slug}`} class="group block">
                <span class="cote">{f.famille}</span>
                <h3 class="titre-rubrique mt-3 transition-colors duration-150 group-hover:text-tirage">
                  {f.terme}
                </h3>
                <p class="mt-3 max-w-[44ch] text-[0.9375rem] leading-[1.6] text-graphite">
                  {f.definition}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    questionsLiees.length > 0 && (
      <section class="planche pb-14 lg:pb-20">
        <h2 class="cote">Questions sur ce sujet</h2>
        <ul class="mt-7 border-t border-encre">
          {questionsLiees.map((q) => (
            <li data-rangee class="border-b border-tirage-pale">
              <a
                href={`/questions/${q.slug}`}
                class="group grid gap-3 py-7 lg:grid-cols-12 lg:gap-10"
              >
                <h3 class="titre-rubrique max-w-[32ch] transition-colors duration-150 group-hover:text-tirage lg:col-span-5">
                  {q.question}
                </h3>
                <p class="max-w-[68ch] text-[0.9375rem] leading-[1.6] text-graphite lg:col-span-7">
                  {q.reponseCourte}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Les autres expertises, pour que la page ne soit jamais un cul-de-sac. */}
  <section class="planche pb-16 lg:pb-24">
    <h2 class="cote">Les autres expertises</h2>
    <ul class="mt-7 flex flex-wrap gap-x-3 gap-y-3">
      <li><a href="/financement" class="etiquette etiquette-encre">Financement</a></li>
      {
        autres.map((p) => (
          <li>
            <a href={`/expertises/${p.slug}`} class="etiquette etiquette-encre">
              {p.titre}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 border-t border-encre pt-10">
      <p class="titre-planche max-w-[22ch]">Un sujet précis à traiter ?</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={RDV_HREF} class="etiquette">{RDV}</a>
        <a href="/lexique" class="etiquette etiquette-encre">Le lexique</a>
      </div>
    </div>
  </section>
</Base>
