---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import ExpertiseCard from '../components/ExpertiseCard.astro';
import { EXPERTISES } from '../data/contenu';
---

<Base
  titre="Expertises"
  description="Direction financière à temps partagé, financement, subventions, M&A, structuration du développement et pilotage de la performance."
>
  <Masthead
    surtitre="L'offre"
    titre="Six expertises, séparées ou combinées"
    phrase="Vous prenez ce dont vous avez besoin, au moment où vous en avez besoin."
  />

  <section class="py-px">
    <div class="conteneur">
      <div class="grid gap-px bg-bord md:grid-cols-2">
        {
          EXPERTISES.map((expertise, i) => (
            <ExpertiseCard titre={expertise.titre} phrase={expertise.phrase} rang={i + 1} niveau={2} />
          ))
        }
      </div>
    </div>
  </section>

  <div class="h-24 lg:h-32"></div>
</Base>
