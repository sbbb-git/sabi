---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import BandePhoto from '../components/BandePhoto.astro';
import pont from '../assets/pont.jpg';
import EnTetePlanche from '../components/EnTetePlanche.astro';
import FilAriane from '../components/FilAriane.astro';
import { filAriane } from '../lib/schema';
import { RDV, RDV_HREF } from '../consts';
import { EXPERTISES_DETAIL } from '../data/contenu';

const maillons = [{ libelle: 'Accueil', href: '/' }, { libelle: 'Expertises' }];
---

<Base
  titre="Expertises"
  description="DAF à temps partagé, financement bancaire et non dilutif, subventions publiques, M&A, structuration de groupe et pilotage par la donnée, à Paris."

  schemas={[filAriane(maillons)]}
>
  <FilAriane maillons={maillons} />

  <EnTetePlanche
    rubrique="Rubrique 01 · L'offre"
    titre="Six expertises"
    objet="Vous prenez ce dont vous avez besoin, au moment où vous en avez besoin. Une direction financière complète, ou une seule expertise."
  />

  <BandePhoto src={pont} legende="Ouvrage de franchissement sur la Seine" />

  <section class="planche py-16 lg:py-20 lg:pb-28">
    <div class="border-t border-encre">
      {
        EXPERTISES_DETAIL.map((e, i) => (
          <article
            data-rangee
            id={`expertise-${i + 1}`}
            class="grid gap-6 border-b border-tirage-pale py-12 lg:grid-cols-12 lg:gap-10 lg:py-16"
          >
            <div class="lg:col-span-4">
              <div class="flex items-center gap-4">
                <span class="repere">{String(i + 1).padStart(2, '0')}</span>
                <Icone nom={e.icone} taille={40} class="text-tirage" />
              </div>
              <h2 class="titre-planche mt-5 max-w-[16ch]" style="font-size:clamp(1.5rem,2.4vw,2rem)">
                <a href={e.href} class="transition-colors duration-150 hover:text-tirage">
                  {e.titre}
                </a>
              </h2>
              <p class="mt-4 max-w-[34ch] text-[1rem] leading-[1.6] text-encre">{e.phrase}</p>
            </div>

            <div class="lg:col-span-8">
              <p class="max-w-[68ch] text-[1.0625rem] leading-[1.7] text-graphite">{e.developpe}</p>

              <p class="cote mt-9">Ce que couvre l'intervention</p>
              <ul class="mt-4 border-t border-tirage-pale">
                {e.couvre.map((c) => (
                  <li class="flex items-start gap-3 border-b border-tirage-pale py-3">
                    <span class="mt-2.5 h-px w-4 shrink-0 bg-tirage" aria-hidden="true" />
                    <span class="text-[0.9375rem] leading-[1.6] text-graphite">{c}</span>
                  </li>
                ))}
              </ul>

              <a href={e.href} class="renvoi mt-8 inline-flex">
                {e.titre === 'Financement' ? 'Financer votre ambition' : `${e.titre} en détail`}
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-14 flex flex-wrap items-center gap-3">
      <a href={RDV_HREF} class="etiquette">{RDV}</a>
      <a href="/references" class="etiquette etiquette-encre">Voir les missions conduites</a>
    </div>
  </section>
</Base>
