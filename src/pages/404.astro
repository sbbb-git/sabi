---
import Base from '../layouts/Base.astro';
import { NAV } from '../consts';
---

<Base
  titre="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez les expertises, les références et le contact du cabinet depuis cette page."
  noindex
>
  <section class="pt-24 pb-24 lg:pt-32 lg:pb-32">
    <div class="conteneur">
      <p class="surtitre">Erreur 404</p>
      <h1 class="titre-page mt-5">Cette page n'existe pas.</h1>
      <p class="accroche mesure mt-6">
        Le lien est peut-être ancien, ou la page a été déplacée.
      </p>

      <ul class="mt-14 grid gap-px border-t border-bord sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {
          NAV.map((lien) => (
            <li class="border-b border-bord">
              <a
                href={lien.href}
                class="group flex items-center justify-between py-6 pr-2 text-[1.0625rem] font-medium text-nuit transition-colors duration-150 hover:text-bleu sm:pr-8"
              >
                {lien.libelle}
                <span
                  class="transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-14">
        <a href="/" class="action action-accent">
          Revenir à l'accueil
          <span class="fleche" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
