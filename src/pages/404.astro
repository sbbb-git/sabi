---
import Base from '../layouts/Base.astro';
import { NAV } from '../consts';
---

<Base
  titre="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez les expertises, les références et le contact du cabinet depuis cette page."
  noindex
>
  <section class="pt-36 pb-24 lg:pt-44 lg:pb-32">
    <div class="planche">
      <p class="cote cote-accent">Erreur 404</p>
      <h1 class="titre-planche mt-6">Cette page n'existe pas.</h1>
      <p class="mesure mt-6 text-[1.0625rem] text-graphite">
        Le lien est peut-être ancien, ou la page a été déplacée.
      </p>

      <ul class="mt-14 grid border-t border-encre sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {
          NAV.map((lien) => (
            <li class="border-b border-tirage-pale">
              <a
                href={lien.href}
                class="group flex items-center justify-between py-6 pr-2 text-[1.0625rem] font-medium text-encre transition-colors duration-150 hover:text-tirage sm:pr-8"
              >
                {lien.libelle}
                <span
                  class="transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-14">
        <a href="/" class="renvoi">
          Revenir à l'accueil
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>
