---
/**
 * Une fiche du lexique.
 *
 * La définition d'ouverture est posée en gros, seule, avant tout le reste.
 * C'est le bloc qu'un moteur extrait pour répondre directement à « c'est quoi
 * X », et c'est aussi ce que lit un dirigeant pressé. Les deux publics veulent
 * la même chose : une phrase juste, tout de suite.
 */
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/FilAriane.astro';
import { RDV, RDV_HREF } from '../../consts';
import { FICHES, parSlugFiche } from '../../data/lexique';
import { QUESTIONS_PAGES } from '../../data/questions';
import { filAriane, termeDefini } from '../../lib/schema';

export function getStaticPaths() {
  return FICHES.map((fiche) => ({ params: { slug: fiche.slug }, props: { fiche } }));
}

const { fiche } = Astro.props;
const chemin = `/lexique/${fiche.slug}`;

const maillons = [
  { libelle: 'Accueil', href: '/' },
  { libelle: 'Lexique', href: '/lexique' },
  { libelle: fiche.terme },
];

const voisins = fiche.voisins.map(parSlugFiche).filter((f) => f !== undefined);
/* Les questions où cette notion est employée. Dérivées, jamais saisies. */
const questionsLiees = QUESTIONS_PAGES.filter((q) => q.lexique?.includes(fiche.slug));

const schemas = [
  filAriane(maillons),
  termeDefini({ terme: fiche.terme, definition: fiche.definition, chemin }),
];

const description =
  fiche.definition.length <= 155
    ? fiche.definition
    : `${fiche.definition.slice(0, 152).trimEnd()}...`;
---

<Base titre={fiche.titreMeta} description={description} schemas={schemas}>
  <FilAriane maillons={maillons} />

  <article>
    <section class="planche pt-8 pb-12 lg:pt-10 lg:pb-16">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3">
          <p class="cote">{fiche.famille}</p>
          <span class="ligne-cote mt-5 block w-24" aria-hidden="true"></span>
          {
            fiche.aussi && (
              <p class="mt-7 max-w-[24ch] text-[0.8125rem] leading-[1.6] text-graphite">
                Aussi appelé {fiche.aussi.join(', ')}.
              </p>
            )
          }
        </div>
        <div class="lg:col-span-9">
          <h1 class="titre-planche max-w-[18ch]" style="font-size:clamp(2.25rem,5vw,3.75rem)">
            {fiche.terme}
          </h1>
          {/* La définition, seule et en grand. C'est la réponse à la question posée. */}
          <p
            class="mt-8 max-w-[44ch] text-[1.25rem] leading-[1.35] font-semibold tracking-[-0.02em] text-encre lg:text-[1.5rem]"
            style="font-stretch:88%"
          >
            {fiche.definition}
          </p>
        </div>
      </div>
    </section>

    <section class="planche pb-12 lg:pb-16">
      <div class="border-t border-encre">
        {
          fiche.corps.map((bloc, i) => (
            <div
              data-rangee
              class="grid gap-4 border-b border-tirage-pale py-9 lg:grid-cols-12 lg:gap-10 lg:py-12"
            >
              <div class="lg:col-span-4">
                <span class="repere">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="titre-rubrique mt-5 max-w-[24ch]">{bloc.titre}</h2>
              </div>
              <div class="space-y-4 lg:col-span-8">
                {bloc.paragraphes.map((t) => (
                  <p class="max-w-[66ch] text-[1.0625rem] leading-[1.7] text-graphite">{t}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bg-papier-clair">
      <div class="planche py-14 lg:py-20">
        <h2 class="cote">À retenir</h2>
        <ul class="mt-8 border-t border-encre">
          {
            fiche.aRetenir.map((r, i) => (
              <li
                data-rangee
                class="flex items-baseline gap-5 border-b border-tirage-pale py-5"
              >
                <span class="repere shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="max-w-[62ch] text-[1.0625rem] leading-[1.6] text-encre">{r}</span>
              </li>
            ))
          }
        </ul>

        {
          fiche.expertise && (
            <div class="mt-10">
              <p class="max-w-[54ch] text-[0.9375rem] leading-[1.7] text-graphite">
                C'est un sujet que le cabinet traite. Le détail se trouve sur la page
                de l'expertise concernée.
              </p>
              <a href={fiche.expertise.href} class="renvoi mt-5 inline-flex">
                {fiche.expertise.libelle}
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          )
        }
      </div>
    </section>
  </article>

  {
    questionsLiees.length > 0 && (
      <section class="planche py-14 lg:py-20">
        <h2 class="cote">Là où cette notion se pose</h2>
        <ul class="mt-7 border-t border-encre">
          {questionsLiees.map((q) => (
            <li data-rangee class="border-b border-tirage-pale">
              <a
                href={`/questions/${q.slug}`}
                class="group grid gap-3 py-7 lg:grid-cols-12 lg:gap-10"
              >
                <h3 class="titre-rubrique max-w-[32ch] transition-colors duration-150 group-hover:text-tirage lg:col-span-5">
                  {q.question}
                </h3>
                <p class="max-w-[68ch] text-[0.9375rem] leading-[1.6] text-graphite lg:col-span-7">
                  {q.reponseCourte}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    voisins.length > 0 && (
      <section class="planche py-14 lg:py-20">
        <h2 class="cote">À lire ensuite</h2>
        <ul class="mt-7 grid gap-px border-t border-encre lg:grid-cols-3">
          {voisins.map((v, i) => (
            <li
              data-rangee
              class:list={[
                'border-b border-tirage-pale py-7',
                i > 0 ? 'lg:border-l lg:pl-8' : 'lg:pr-8',
              ]}
            >
              <a href={`/lexique/${v.slug}`} class="group block">
                <span class="cote">{v.famille}</span>
                <h3 class="titre-rubrique mt-3 transition-colors duration-150 group-hover:text-tirage">
                  {v.terme}
                </h3>
                <p class="mt-3 max-w-[44ch] text-[0.9375rem] leading-[1.6] text-graphite">
                  {v.definition}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="planche pb-16 lg:pb-24">
    <div class="border-t border-encre pt-10">
      <p class="titre-planche max-w-[24ch]">Ce sujet se pose chez vous ?</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={RDV_HREF} class="etiquette">{RDV}</a>
        <a href="/lexique" class="etiquette etiquette-encre">Tout le lexique</a>
      </div>
    </div>
  </section>
</Base>
