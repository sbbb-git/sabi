---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ReferenceRow from '../components/ReferenceRow.astro';
import { REFERENCES } from '../data/contenu';
---

<Base
  titre="Références"
  description="Les missions conduites par le cabinet, décrites par leur objet : structuration de groupe, financement, subventions, cession et dossier ARS."
>
  <section class="pt-24 pb-16 lg:pt-32 lg:pb-24">
    <div class="conteneur">
      <SectionTitle
        surtitre="Missions conduites"
        titre="Des dossiers menés, décrits par leur objet"
        principal
      />
    </div>
  </section>

  <section class="pb-20 lg:pb-28">
    <div class="conteneur">
      {REFERENCES.map((ref) => <ReferenceRow {...ref} niveau={2} />)}
      <div class="filet" aria-hidden="true"></div>

      <p class="reveal mt-16 text-[1.5rem] leading-[1.3] font-semibold tracking-[-0.015em] text-bleu lg:mt-20 lg:text-[2rem]">
        Prochaine réalisation : la vôtre.
      </p>
    </div>
  </section>
</Base>
