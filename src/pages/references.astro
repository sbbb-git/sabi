---
import Base from '../layouts/Base.astro';
import EnTetePlanche from '../components/EnTetePlanche.astro';
import { REFERENCES } from '../data/contenu';
---

<Base
  titre="Références"
  description="Missions conduites par le cabinet : structuration de groupe multi-entités, financement bancaire, crédit-bail, subventions et cession de société."
>
  <EnTetePlanche rubrique="Rubrique 02 · Missions conduites" titre="Des dossiers menés, décrits par leur objet" />

  <section class="planche pb-16 lg:pb-24">
    <div class="border-t border-encre">
      {
        REFERENCES.map((ref) => (
          <article class="grid gap-3 border-b border-tirage-pale py-8 lg:grid-cols-12 lg:items-baseline lg:gap-10">
            <p class="cote lg:col-span-3">{ref.secteur}</p>
            <div class="lg:col-span-6">
              <h2 class="titre-rubrique">{ref.objet}</h2>
              <p class="mt-3 max-w-[52ch] text-[0.9375rem] leading-[1.55] text-graphite">{ref.phrase}</p>
            </div>
            <p class="cote cote-accent lg:col-span-3 lg:text-right">{ref.chiffre ?? ''}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-14 text-[1.5rem] leading-[1.15] font-semibold tracking-[-0.025em] text-tirage lg:mt-20 lg:text-[2.25rem]" style="font-stretch:86%">
      Prochaine réalisation : la vôtre.
    </p>
  </section>
</Base>
