---
import Base from '../layouts/Base.astro';
import EnTetePlanche from '../components/EnTetePlanche.astro';
import FilAriane from '../components/FilAriane.astro';
import { filAriane } from '../lib/schema';
import BandePhoto from '../components/BandePhoto.astro';
import ciel from '../assets/ciel.webp';
import { REFERENCES } from '../data/contenu';

const maillons = [{ libelle: 'Accueil', href: '/' }, { libelle: 'Références' }];
---

<Base
  titre="Références"
  description="Missions conduites par le cabinet : structuration de groupe multi-entités, financement bancaire, crédit-bail, subventions et cession de société."

  schemas={[filAriane(maillons)]}
>
  <FilAriane maillons={maillons} />

  <EnTetePlanche rubrique="Rubrique 02 · Missions conduites" titre="Nos réalisations" />

  {/* Des plaques, pas des lignes. Le client a demandé des cartes : ce sont des
      cadres au trait, sans ombre et sans coin arrondi, pour rester dans la
      planche. Chaque plaque porte son secteur, son objet et sa cote. */}
  <section class="planche pb-16 lg:pb-24">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        REFERENCES.map((ref) => (
          <li
            data-rangee
            class="group flex h-full flex-col border border-tirage-pale bg-papier p-6 transition-colors duration-200 hover:border-encre lg:p-7"
          >
            <p class="cote">{ref.secteur}</p>
            <h2 class="titre-rubrique mt-5 max-w-[24ch]">{ref.objet}</h2>
            <p class="mt-4 max-w-[38ch] text-[0.9375rem] leading-[1.6] text-graphite">
              {ref.phrase}
            </p>
            {ref.chiffre && (
              <p
                data-compteur
                class="mt-auto border-t border-tirage-pale pt-5 text-[1.5rem] leading-none font-semibold tracking-[-0.03em] text-tirage tabular-nums lg:text-[1.75rem]"
                style="font-stretch:84%"
              >
                {ref.chiffre}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-14 text-[1.5rem] leading-[1.15] font-semibold tracking-[-0.025em] text-tirage lg:mt-20 lg:text-[2.25rem]" style="font-stretch:86%">
      Prochaine réalisation : la vôtre.
    </p>
  </section>

  <BandePhoto src={ciel} legende="Ligne de toits" />
</Base>
