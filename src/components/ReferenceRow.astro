---
interface Props {
  secteur: string;
  objet: string;
  phrase: string;
  chiffre?: string;
  niveau?: 2 | 3;
}

const { secteur, objet, phrase, chiffre, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
---

<article class="reveal filet group py-10 lg:py-14">
  <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-3">
      <p class="surtitre">{secteur}</p>
    </div>

    <div class="lg:col-span-6">
      <Titre class="font-titre text-[1.375rem] leading-[1.25] tracking-[-0.01em] text-nuit lg:text-[1.625rem]">
        {objet}
      </Titre>
      <p class="mesure mt-3 text-corps text-texte">{phrase}</p>
    </div>

    <div class="lg:col-span-3 lg:text-right">
      {
        chiffre && (
          <p class="chiffre text-[1.75rem] text-bronze lg:text-[2rem]">{chiffre}</p>
        )
      }
    </div>
  </div>
</article>
