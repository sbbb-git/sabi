---
interface Props {
  secteur: string;
  objet: string;
  phrase: string;
  chiffre?: string;
  /** Niveau de titre. 2 quand la ligne suit directement le h1 de la page. */
  niveau?: 2 | 3;
}

const { secteur, objet, phrase, chiffre, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
---

<article class="reveal filet py-10 lg:py-12">
  <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-3">
      <p class="surtitre">{secteur}</p>
    </div>

    <div class="lg:col-span-6">
      <Titre class="text-[1.1875rem] leading-[1.4] font-semibold tracking-[-0.01em] text-nuit">
        {objet}
      </Titre>
      <p class="mesure mt-3 text-corps text-texte">{phrase}</p>
    </div>

    <div class="lg:col-span-3 lg:text-right">
      {
        chiffre && (
          <p class="text-[1.375rem] leading-[1.3] font-semibold tracking-[-0.015em] text-bleu">
            {chiffre}
          </p>
        )
      }
    </div>
  </div>
</article>
