---
interface Props {
  texte?: string;
  class?: string;
}

const { texte, class: classe = '' } = Astro.props;
---

<section class:list={['bg-nuit', classe]}>
  <div class="conteneur">
    <div class="py-20 lg:py-28">
      {
        texte ? (
          <div class="reveal grid gap-8 lg:grid-cols-12">
            <span class="h-px w-16 self-start bg-sable lg:col-span-2 lg:mt-4" aria-hidden="true" />
            <p class="font-titre max-w-[30ch] text-[1.625rem] leading-[1.25] text-blanc lg:col-span-10 lg:text-[2.25rem]">
              {texte}
            </p>
          </div>
        ) : (
          <slot />
        )
      }
    </div>
  </div>
</section>
