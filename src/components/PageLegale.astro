---
import Base from '../layouts/Base.astro';
import Masthead from './Masthead.astro';

interface Props {
  titre: string;
  description: string;
  miseAJour: string;
}

const { titre, description, miseAJour } = Astro.props;
---

<Base titre={titre} description={description} noindex>
  <Masthead surtitre="Informations légales" titre={titre} />

  <section class="pt-14 pb-24 lg:pt-20 lg:pb-32">
    <div class="conteneur">
      <p class="mb-12 text-[0.9375rem] text-gris">Dernière mise à jour : {miseAJour}</p>
      <div class="legale mesure">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .legale h2 {
    font-family: var(--font-titre);
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-nuit);
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-bord);
  }

  .legale h2:first-child {
    margin-top: 0;
  }

  .legale p,
  .legale ul {
    margin-top: 1rem;
    color: var(--color-texte);
  }

  .legale ul {
    list-style: none;
    padding-left: 0;
  }

  .legale li {
    padding-left: 1.125rem;
    position: relative;
    margin-top: 0.5rem;
  }

  .legale li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 1px;
    background-color: var(--color-bronze);
  }

  .legale a {
    color: var(--color-bronze);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Marqueur des informations que Sacha doit fournir avant mise en ligne. */
  .a-completer {
    background-color: var(--color-creme);
    border-bottom: 1px solid var(--color-bronze);
    padding: 0 0.25rem;
    font-weight: 500;
    color: var(--color-nuit);
  }
</style>
