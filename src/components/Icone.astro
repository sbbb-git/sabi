---
/**
 * Les pictogrammes de la planche.
 *
 * Ce ne sont pas des icônes d'interface. Chacune est un petit détail de dessin
 * technique : une forme construite, ses lignes de construction en trait fin, et
 * une cote quand elle dit quelque chose. Bouts carrés, angles vifs, jamais
 * d'arrondi, jamais de remplissage. C'est le même vocabulaire que `.ligne-cote`
 * et `.repere`, à l'échelle du picto.
 *
 * Grille 32 × 32. Trait porteur à 1.25, ligne de construction à 0.75 et 40 %
 * d'opacité, comme sur un calque où le crayon de construction reste visible
 * sous l'encre.
 */
export type NomIcone =
  | 'direction'
  | 'financement'
  | 'subvention'
  | 'transmission'
  | 'structuration'
  | 'pilotage'
  | 'nondilutif'
  | 'dilutif'
  | 'cadrer'
  | 'dossier'
  | 'parallele'
  | 'negocier'
  | 'lancement'
  | 'croissance'
  | 'groupe'
  | 'operation'
  | 'donnee';

interface Props {
  nom: NomIcone;
  taille?: number;
  class?: string;
}

const { nom, taille = 32, class: classe = '' } = Astro.props;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
  data-picto
  class={classe}
>
  {/* Direction financière à temps partagé : le carré des jours, la part prise. */}
  {
    nom === 'direction' && (
      <>
        <path d="M5 6h22v20H5z" />
        <path d="M5 6h9v20H5z" stroke-width="0.75" opacity="0.4" />
        <path d="M14 6v20" />
        <path d="M18.5 12.5h5M18.5 16h8M18.5 19.5h5" stroke-width="0.75" opacity="0.4" />
        <path d="M5 29.5h9" stroke-width="0.75" />
        <path d="M5 28v3M14 28v3" stroke-width="0.75" />
      </>
    )
  }

  {/* Financement : plusieurs sources interrogées, une seule entrée. */}
  {
    nom === 'financement' && (
      <>
        <path d="M2 6h7M2 16h7M2 26h7" stroke-width="0.75" opacity="0.4" />
        <path d="M9 6h5l4 10M9 16h9M9 26h5l4-10" stroke-width="0.75" />
        <path d="M18 16h4" />
        <path d="M22 9h8v14h-8z" />
        <path d="M26 13v6M23 16h6" stroke-width="0.75" opacity="0.4" />
      </>
    )
  }

  {/* Subventions : le guichet, et la date limite qui décide de tout. */}
  {
    nom === 'subvention' && (
      <>
        <path d="M5 4h16l6 6v18H5z" />
        <path d="M21 4v6h6" stroke-width="0.75" />
        <circle cx="12" cy="20" r="5" />
        <path d="M12 17v3l2 2" stroke-width="0.75" />
        <path d="M19 19h6M19 23h4" stroke-width="0.75" opacity="0.4" />
      </>
    )
  }

  {/* M&A : deux périmètres, un passage de main, une date de closing. */}
  {
    nom === 'transmission' && (
      <>
        <path d="M2 9h11v14H2z" />
        <path d="M19 9h11v14H19z" stroke-dasharray="2.5 2" />
        <path d="M13 16h6" />
        <path d="M16.5 13.5 19 16l-2.5 2.5" stroke-width="0.75" />
        <path d="M2 27.5h11M19 27.5h11" stroke-width="0.75" opacity="0.4" />
      </>
    )
  }

  {/* Structuration : la holding, les filles, la consolidation. */}
  {
    nom === 'structuration' && (
      <>
        <path d="M11 2h10v7H11z" />
        <path d="M16 9v5" stroke-width="0.75" />
        <path d="M5 14h22" stroke-width="0.75" />
        <path d="M5 14v4M16 14v4M27 14v4" stroke-width="0.75" />
        <path d="M1 18h8v8H1zM12 18h8v8h-8zM23 18h8v8h-8z" />
      </>
    )
  }

  {/* Pilotage : la série, la tendance, le seuil. */}
  {
    nom === 'pilotage' && (
      <>
        <path d="M3 3v25h26" />
        <path d="M3 12h26" stroke-width="0.75" stroke-dasharray="2 2.5" opacity="0.5" />
        <path d="M8 22v6M14 17v11M20 20v8M26 9v19" />
        <path d="m8 22 6-5 6 3 6-11" stroke-width="0.75" opacity="0.55" />
      </>
    )
  }

  {/* Non dilutif : le capital reste entier. */}
  {
    nom === 'nondilutif' && (
      <>
        <circle cx="16" cy="16" r="11" />
        <circle cx="16" cy="16" r="6.5" stroke-width="0.75" opacity="0.4" />
        <path d="M16 2v4M16 26v4M2 16h4M26 16h4" stroke-width="0.75" />
      </>
    )
  }

  {/* Dilutif : une part sort du périmètre. */}
  {
    nom === 'dilutif' && (
      <>
        <path d="M16 5a11 11 0 1 0 11 11" />
        <path d="M19 3.4A11 11 0 0 1 28.6 13" stroke-dasharray="2.5 2" />
        <path d="M16 16 16 5M16 16l9.5 4" stroke-width="0.75" />
        <path d="M22.5 5.5 26 2M26 2h-4M26 2v4" stroke-width="0.75" opacity="0.6" />
      </>
    )
  }

  {/* Cadrer : le besoin, mesuré avant d'être cherché. */}
  {
    nom === 'cadrer' && (
      <>
        <path d="M6 9h20v14H6z" />
        <path d="M6 5.5h20M6 4v3M26 4v3" stroke-width="0.75" />
        <path d="M2.5 9v14M1 9h3M1 23h3" stroke-width="0.75" />
        <path d="M11 16h10" stroke-width="0.75" opacity="0.4" />
      </>
    )
  }

  {/* Le dossier : les pièces, empilées et tenues. */}
  {
    nom === 'dossier' && (
      <>
        <path d="M9 2h11l6 6v18H9z" />
        <path d="M20 2v6h6" stroke-width="0.75" />
        <path d="M6 6v24h17" stroke-width="0.75" opacity="0.4" />
        <path d="M13 13h9M13 17h9M13 21h5" stroke-width="0.75" />
      </>
    )
  }

  {/* Plusieurs portes ouvertes en même temps. */}
  {
    nom === 'parallele' && (
      <>
        <path d="M2 16h6" />
        <path d="M8 16h5v-10h6M8 16h5M13 16h6M8 16h5v10h6" stroke-width="0.75" />
        <path d="M19 2h11v8H19zM19 12h11v8H19zM19 22h11v8H19z" />
      </>
    )
  }

  {/* Négocier : deux positions qui se rapprochent d'une même ligne. */}
  {
    nom === 'negocier' && (
      <>
        <path d="M16 2v28" stroke-width="0.75" stroke-dasharray="2 2.5" opacity="0.55" />
        <path d="M2 6h8v8H2z" />
        <path d="M22 18h8v8h-8z" />
        <path d="M10 10h4.5" stroke-width="0.75" />
        <path d="m12.5 8 2 2-2 2" stroke-width="0.75" />
        <path d="M22 22h-4.5" stroke-width="0.75" />
        <path d="m19.5 20-2 2 2 2" stroke-width="0.75" />
      </>
    )
  }

  {/* Le lancement : le projet franchit le seuil. */}
  {
    nom === 'lancement' && (
      <>
        <path d="M3 29h26" />
        <path d="M3 13h26" stroke-width="0.75" stroke-dasharray="2 2.5" opacity="0.55" />
        <path d="M3 27 27 5" />
        <path d="M20 5h7v7" stroke-width="0.75" />
        <circle cx="16.5" cy="13" r="2.75" />
      </>
    )
  }

  {/* La croissance qui dépasse la structure. */}
  {
    nom === 'croissance' && (
      <>
        <path d="M3 29h26" stroke-width="0.75" />
        <path d="M3 29v-6h7v6M10 29v-11h7v11M17 29v-16h7v16" stroke-width="0.75" opacity="0.45" />
        <path d="m2 21 8-5 7 6 12-15" />
        <path d="M24 7h6v6" stroke-width="0.75" />
      </>
    )
  }

  {/* Le groupe : des entités, un périmètre consolidé. */}
  {
    nom === 'groupe' && (
      <>
        <path d="M2 3h28v26H2z" stroke-width="0.75" stroke-dasharray="3 2.5" opacity="0.5" />
        <path d="M6 7h9v8H6zM17 7h9v8h-9zM6 17h9v8H6zM17 17h9v8h-9z" />
        <path d="M15 11h2M11 15v2M21 15v2M15 21h2" stroke-width="0.75" opacity="0.5" />
      </>
    )
  }

  {/* Une opération : deux périmètres qui se recouvrent. */}
  {
    nom === 'operation' && (
      <>
        <circle cx="12" cy="16" r="9" />
        <circle cx="20" cy="16" r="9" stroke-dasharray="2.5 2" />
        <path d="M16 8.5v15" stroke-width="0.75" opacity="0.5" />
        <path d="M12 29.5h8M12 28v3M20 28v3" stroke-width="0.75" opacity="0.4" />
      </>
    )
  }

  {/* La donnée : la trame, et le point qu'on cherchait. */}
  {
    nom === 'donnee' && (
      <>
        <path d="M4 4h24v24H4z" />
        <path d="M12 4v24M20 4v24M4 12h24M4 20h24" stroke-width="0.75" opacity="0.4" />
        <path d="M20 20h8v8h-8z" />
        <path d="M22.5 24h3M24 22.5v3" stroke-width="0.75" />
      </>
    )
  }
</svg>
