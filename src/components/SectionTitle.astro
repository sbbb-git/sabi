---
interface Props {
  surtitre?: string;
  titre: string;
  phrase?: string;
  sombre?: boolean;
  class?: string;
}

const { surtitre, titre, phrase, sombre = false, class: classe = '' } = Astro.props;
---

<div class:list={['reveal', classe]}>
  {surtitre && <p class:list={['surtitre', sombre && 'surtitre-sombre']}>{surtitre}</p>}
  <h2 class:list={['titre-section mesure', surtitre && 'mt-5', sombre && 'titre-clair']}>
    {titre}
  </h2>
  {phrase && <p class:list={['accroche mesure mt-6', sombre && 'text-sur-nuit']}>{phrase}</p>}
</div>
