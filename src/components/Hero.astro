---
interface Props {
  surtitre?: string;
  titre: string;
  phrase: string;
}

const { surtitre, titre, phrase } = Astro.props;
---

{/* Héros pleine hauteur sur aplat nuit. Aucune image, le texte fait le décor. */}
<section class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-nuit pt-32 pb-16 lg:pb-20">
  {/* Filets verticaux : la seule texture de la page. */}
  <div
    class="pointer-events-none absolute inset-0 hidden lg:block"
    aria-hidden="true"
  >
    <div class="conteneur h-full">
      <div class="grid h-full grid-cols-4">
        <span class="border-l border-[color-mix(in_srgb,var(--color-sable)_10%,transparent)]"></span>
        <span class="border-l border-[color-mix(in_srgb,var(--color-sable)_10%,transparent)]"></span>
        <span class="border-l border-[color-mix(in_srgb,var(--color-sable)_10%,transparent)]"></span>
        <span class="border-x border-[color-mix(in_srgb,var(--color-sable)_10%,transparent)]"></span>
      </div>
    </div>
  </div>

  <div class="conteneur relative">
    {surtitre && <p class="surtitre surtitre-sombre reveal">{surtitre}</p>}

    <h1 class:list={['titre-display titre-clair reveal max-w-[14ch]', surtitre && 'mt-7']}>
      {titre}
    </h1>

    <p class="reveal mt-8 max-w-[38ch] text-[1.1875rem] leading-[1.55] [text-wrap:balance] text-sur-nuit lg:mt-10 lg:text-[1.375rem]">
      {phrase}
    </p>

    <div class="reveal mt-11 flex flex-col gap-4 sm:flex-row sm:items-center lg:mt-14">
      <slot name="actions" />
    </div>
  </div>
</section>
