---
/**
 * La planche photo. Sur un dossier de plans, une vue photographique s'insère
 * entre deux feuilles de dessin, pleine largeur, avec sa légende cotée en pied.
 * C'est ce que fait cette bande : elle coupe une page de texte, elle ne décore
 * pas une section.
 *
 * L'image est désaturée par `.tirage-photo` : aucune couleur ne doit entrer
 * dans la planche en dehors de l'encre et du tirage.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  legende: string;
  /** Hauteur de la bande. `courte` pour une respiration, `haute` pour un temps fort. */
  hauteur?: 'courte' | 'haute';
  class?: string;
}

const { src, legende, hauteur = 'courte', class: classe = '' } = Astro.props;
const h = hauteur === 'haute' ? 'h-[clamp(260px,38vw,520px)]' : 'h-[clamp(190px,26vw,360px)]';
---

<figure class:list={['relative isolate overflow-hidden bg-encre', h, classe]}>
  <Image
    src={src}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    quality={58}
    class="tirage-photo absolute inset-0 -z-10 h-full w-full object-cover"
    loading="lazy"
  />
  {/* L'encre ne revient que sous la légende, pour la tenir lisible. Le reste
      de la vue reste une photographie, pas un aplat teinté. */}
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(11,23,40,0.94)_0%,rgba(11,23,40,0.45)_18%,rgba(11,23,40,0)_42%)]"
    aria-hidden="true"
  >
  </div>

  <figcaption class="planche absolute inset-x-0 bottom-0 pb-6 lg:pb-8">
    <span class="ligne-cote mb-3 block w-16" aria-hidden="true"></span>
    <span class="cote cote-claire">{legende}</span>
  </figcaption>
</figure>
