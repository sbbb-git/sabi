---
/**
 * La planche photo. Sur un dossier de plans, une vue photographique s'insère
 * entre deux feuilles de dessin, pleine largeur, avec sa légende cotée en pied.
 * C'est ce que fait cette bande : elle coupe une page de texte, elle ne décore
 * pas une section.
 *
 * L'image est désaturée par `.tirage-photo` : aucune couleur ne doit entrer
 * dans la planche en dehors de l'encre et du tirage.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /**
   * Décrit la vue pour les lecteurs d'écran. Elle n'est plus affichée : la
   * légende cotée en pied a été retirée sur demande du client.
   */
  legende: string;
  /** La bande se fige le temps qu'on la traverse. Réservé à une par page. */
  fige?: boolean;
  /** Un titre posé sur la vue, avec son renvoi. La bande porte alors une section. */
  titre?: string;
  lien?: { libelle: string; href: string };
  /** Hauteur de la bande. `courte` pour une respiration, `haute` pour un temps fort. */
  hauteur?: 'courte' | 'haute';
  class?: string;
}

const {
  src,
  legende,
  hauteur = 'courte',
  fige = false,
  titre,
  lien,
  class: classe = '',
} = Astro.props;

/*
  Une bande figée occupe presque la fenêtre : c'est ce qui fait qu'on la
  traverse au lieu de la croiser. Une bande libre reste une respiration.
*/
const h = fige
  ? 'h-[clamp(300px,54vh,540px)] md:h-[82svh]'
  : hauteur === 'haute'
    ? 'h-[clamp(260px,38vw,520px)]'
    : 'h-[clamp(190px,26vw,360px)]';

/* Le débord sert au glissement ; une bande figée se met à l'échelle à la place. */
const debord = fige ? 'h-full' : 'h-[124%]';
---

<figure
  data-fige={fige ? '' : undefined}
  class:list={['relative isolate overflow-hidden bg-encre', h, classe]}
>
  <Image
    src={src}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    quality={58}
    class:list={['tirage-photo absolute inset-0 -z-10 w-full object-cover', debord]}
    data-parallaxe={fige ? undefined : true}
    data-fige-fond={fige ? '' : undefined}
    loading="lazy"
  />
  {/* Un voile léger, qui raccorde la vue aux sections d'encre voisines sans
      la teinter. Le dégradé fort n'existait que pour porter la légende. */}
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(11,23,40,0.34)_0%,rgba(11,23,40,0.08)_45%,rgba(11,23,40,0.22)_100%)]"
    aria-hidden="true"
  >
  </div>

  {/* La légende reste dans le document, pour les lecteurs d'écran. */}
  <figcaption class="sr-only">{legende}</figcaption>

  {/* Quand la bande porte un titre, elle cesse d'être une respiration : elle
      devient la section elle-même, et l'encre remonte pour tenir le texte. */}
  {
    titre && (
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(11,23,40,0.9)_0%,rgba(11,23,40,0.62)_46%,rgba(11,23,40,0.2)_100%)]"
        aria-hidden="true"
      />
    )
  }
  {
    titre && (
      <div data-fige-contenu class="planche flex h-full items-center">
        <div>
          <span class="ligne-cote mb-6 block w-24" aria-hidden="true" />
          <p class="nom-ouvrage max-w-[14ch] text-blanc" style="font-size:clamp(2rem,5.4vw,4rem)">
            {titre}
          </p>
          {lien && (
            <a href={lien.href} class="renvoi renvoi-clair mt-9 inline-flex">
              {lien.libelle}
              <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </div>
      </div>
    )
  }
</figure>
