---
import { CONTACT, MARQUE, NAV, RDV } from '../consts';

const ici = Astro.url.pathname.replace(/\/$/, '') || '/';
---

{/* Le bandeau de planche : marque à gauche, rubriques cotées, action en étiquette. */}
<header
  class="sticky top-0 z-50 border-b border-tirage-pale bg-papier/95 backdrop-blur-[2px] sans-impression"
>
  <div class="planche">
    <div class="flex h-16 items-center justify-between gap-6 lg:h-[72px]">
      <a href="/" class="flex items-baseline gap-2.5" aria-label={`${MARQUE}, accueil`}>
        <span
          class="text-[1.375rem] leading-none font-semibold tracking-[-0.03em] text-encre lg:text-[1.5rem]"
          style="font-stretch:86%"
        >
          sabi<span class="text-tirage">&amp;</span>co
        </span>
      </a>

      <nav class="hidden items-center gap-5 lg:flex xl:gap-8" aria-label="Navigation principale">
        {
          NAV.map((lien, i) => {
            const actif = ici === lien.href;
            return (
              <a href={lien.href} aria-current={actif ? 'page' : undefined} class="group flex items-baseline gap-2 whitespace-nowrap">
                <span class="cote">{String(i + 1).padStart(2, '0')}</span>
                <span
                  class:list={[
                    'text-[0.9375rem] font-medium transition-colors duration-150',
                    actif ? 'text-tirage' : 'text-encre group-hover:text-tirage',
                  ]}
                  style="font-stretch:90%"
                >
                  {lien.libelle}
                </span>
              </a>
            );
          })
        }
        <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette ml-2">
          {RDV}
        </a>
      </nav>

      <button
        type="button"
        id="bouton-menu"
        class="-mr-1 flex h-11 w-11 items-center justify-center text-encre lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <span class="sr-only">Ouvrir le menu</span>
        <span class="relative block h-3 w-6" aria-hidden="true">
          <span data-barre="haut" class="absolute top-0 left-0 h-px w-6 bg-current transition-transform duration-200"></span>
          <span data-barre="bas" class="absolute bottom-0 left-0 h-px w-6 bg-current transition-transform duration-200"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div id="menu-mobile" hidden class="fixed inset-0 z-40 bg-papier lg:hidden sans-impression">
  <div class="planche flex h-full flex-col pt-24 pb-10">
    <nav class="flex flex-col" aria-label="Navigation mobile">
      {
        NAV.map((lien, i) => (
          <a href={lien.href} class="trait flex items-baseline gap-4 py-5">
            <span class="cote">{String(i + 1).padStart(2, '0')}</span>
            <span class="titre-planche" style="font-size:1.75rem">{lien.libelle}</span>
          </a>
        ))
      }
      <span class="trait"></span>
    </nav>
    <div class="mt-auto pt-10">
      <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette">{RDV}</a>
      <p class="cote mt-8">{CONTACT.email}</p>
    </div>
  </div>
</div>

<script>
  const bouton = document.getElementById('bouton-menu');
  const menu = document.getElementById('menu-mobile');

  if (bouton && menu) {
    const haut = bouton.querySelector<HTMLElement>('[data-barre="haut"]');
    const bas = bouton.querySelector<HTMLElement>('[data-barre="bas"]');
    const libelle = bouton.querySelector<HTMLElement>('.sr-only');

    const basculer = (ouvrir: boolean) => {
      menu.hidden = !ouvrir;
      bouton.setAttribute('aria-expanded', String(ouvrir));
      document.body.style.overflow = ouvrir ? 'hidden' : '';
      if (libelle) libelle.textContent = ouvrir ? 'Fermer le menu' : 'Ouvrir le menu';
      if (haut) haut.style.transform = ouvrir ? 'translateY(5px) rotate(45deg)' : '';
      if (bas) bas.style.transform = ouvrir ? 'translateY(-6px) rotate(-45deg)' : '';
    };

    bouton.addEventListener('click', () => basculer(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { basculer(false); bouton.focus(); }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) basculer(false);
    });
  }
</script>
