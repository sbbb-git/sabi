---
/**
 * Formulaire de contact, adossé à Formspree. Aucun backend, aucun secret dans
 * le dépôt : l'identifiant d'un formulaire Formspree est public par nature.
 *
 * Sans JavaScript, le navigateur poste et Formspree affiche sa page de
 * confirmation. Avec JavaScript, la réponse est du JSON et la confirmation
 * s'affiche sans rechargement.
 *
 * Tant que FORMSPREE_ID est vide, aucun formulaire n'est affiché : mieux vaut
 * renvoyer vers les coordonnées directes qu'un envoi qui échoue en silence.
 */
import { CONTACT, FORMSPREE_ID } from '../consts';

const action = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : '';

const champ =
  'mt-2 block w-full border border-tirage-pale bg-papier-clair px-4 py-3 text-corps text-encre transition-colors duration-150 focus:border-sanguine focus:outline-none';
const etiquette = 'cote';
---

{
  !action ? (
    <div class="border border-tirage-pale bg-papier-clair p-8">
      <p class="titre-rubrique">
        Le formulaire n'est pas encore actif.
      </p>
      <p class="mt-4 max-w-[46ch] text-[0.9375rem] text-graphite">
        En attendant, écrivez directement ou réservez un créneau. La réponse est la même.
      </p>
      <ul class="mt-6 space-y-2">
        <li>
          <a class="text-sanguine underline underline-offset-[0.2em]" href={`mailto:${CONTACT.email}`}>
            {CONTACT.email}
          </a>
        </li>
        <li>
          <a class="text-sanguine underline underline-offset-[0.2em]" href={`tel:${CONTACT.telephoneLien}`}>
            {CONTACT.telephone}
          </a>
        </li>
      </ul>
    </div>
  ) : (
    <div>
      <form id="formulaire-contact" method="POST" action={action} class="grid gap-6 sm:grid-cols-2">
        <input type="hidden" name="_subject" value="Nouveau message depuis sabi-co.fr" />

        {/* Piège à robots. Formspree écarte l'envoi si ce champ est rempli. */}
        <p class="hidden" aria-hidden="true">
          <label>
            Ne pas remplir
            <input name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div>
          <label class={etiquette} for="nom">
            Nom
          </label>
          <input class={champ} id="nom" name="nom" type="text" autocomplete="name" required />
        </div>

        <div>
          <label class={etiquette} for="societe">
            Société
          </label>
          <input
            class={champ}
            id="societe"
            name="societe"
            type="text"
            autocomplete="organization"
            required
          />
        </div>

        <div>
          <label class={etiquette} for="email">
            Email
          </label>
          <input class={champ} id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div>
          <label class={etiquette} for="telephone">
            Téléphone <span class="font-normal text-gris">(facultatif)</span>
          </label>
          <input class={champ} id="telephone" name="telephone" type="tel" autocomplete="tel" />
        </div>

        <div class="sm:col-span-2">
          <label class={etiquette} for="message">
            Message
          </label>
          <textarea class={champ} id="message" name="message" rows="6" required />
        </div>

        <div class="sm:col-span-2">
          <label class="flex cursor-pointer items-start gap-3 text-[0.9375rem] leading-[1.6] text-graphite">
            <input
              class="mt-1 h-4 w-4 shrink-0 accent-[#B23A1F]"
              id="consentement"
              name="consentement"
              type="checkbox"
              required
            />
            <span>
              J'accepte que les informations saisies soient utilisées pour répondre à ma demande.
              Voir la <a class="text-sanguine underline underline-offset-[0.2em]" href="/politique-de-confidentialite">politique de
              confidentialité</a>.
            </span>
          </label>
        </div>

        <div class="sm:col-span-2">
          <button type="submit" class="etiquette">
            Envoyer
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </form>

      <p
        id="message-confirmation"
        hidden
        role="status"
        class="border border-sanguine bg-papier-clair p-6 text-corps text-encre"
      >
        Message envoyé. Nous revenons vers vous par email.
      </p>

      <p
        id="message-erreur"
        hidden
        role="alert"
        class="mt-6 border border-encre bg-papier-clair p-5 text-corps text-encre"
      >
        L'envoi n'a pas abouti. Écrivez-nous directement à
        <a class="text-sanguine underline underline-offset-[0.2em]" href={`mailto:${CONTACT.email}`}>
          {CONTACT.email}
        </a>.
      </p>
    </div>
  )
}

<script>
  const formulaire = document.getElementById('formulaire-contact') as HTMLFormElement | null;
  const confirmation = document.getElementById('message-confirmation');
  const erreur = document.getElementById('message-erreur');

  formulaire?.addEventListener('submit', async (evenement) => {
    evenement.preventDefault();

    const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (bouton) {
      bouton.disabled = true;
      bouton.style.opacity = '0.6';
    }
    if (erreur) erreur.hidden = true;

    try {
      const reponse = await fetch(formulaire.action, {
        method: 'POST',
        // Formspree renvoie du JSON plutôt que sa page de confirmation
        // dès que la requête l'annonce ainsi.
        headers: { Accept: 'application/json' },
        body: new FormData(formulaire),
      });

      if (!reponse.ok) throw new Error(String(reponse.status));

      formulaire.hidden = true;
      if (confirmation) {
        confirmation.hidden = false;
        confirmation.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    } catch {
      if (erreur) erreur.hidden = false;
      if (bouton) {
        bouton.disabled = false;
        bouton.style.opacity = '';
      }
    }
  });
</script>
