---
/**
 * Le cartouche. Sur une planche, c'est le bloc en pied qui porte l'identité de
 * l'ouvrage, l'échelle, la date et le signataire. Ici il porte aussi l'action :
 * le visiteur agit depuis le cartouche, pas depuis un bouton flottant.
 */
import { CONTACT, MARQUE, NAV_LEGAL, NAV_PIED, RDV } from '../consts';

const annee = new Date().getFullYear();

---

<footer class="cartouche">
  <div class="planche">
    <div class="grid gap-10 py-12 lg:grid-cols-12 lg:gap-8 lg:py-16">
      <div class="lg:col-span-5">
        <p class="text-[1.75rem] leading-none font-semibold tracking-[-0.03em]" style="font-stretch:86%">
          sabi<span class="text-tirage-clair">&amp;</span>co
        </p>
        <div class="mt-7">
          <a href={CONTACT.calendly} target="_blank" rel="noopener noreferrer" class="etiquette">
            {RDV}
          </a>
        </div>
      </div>

      <nav class="lg:col-span-3" aria-label="Navigation de pied de page">
        <p class="cote cote-claire">Rubriques</p>
        <ul class="mt-5 space-y-3">
          {
            NAV_PIED.map((lien) => (
              <li>
                <a href={lien.href} class="text-[0.9375rem] text-papier transition-colors duration-150 hover:text-tirage">
                  {lien.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <p class="cote cote-claire">Contact</p>
        <ul class="mt-5 space-y-3">
          <li><a href={`mailto:${CONTACT.email}`} class="text-[0.9375rem] text-papier hover:text-tirage">{CONTACT.email}</a></li>
          <li><a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" class="text-[0.9375rem] text-papier hover:text-tirage">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-tirage/40 py-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="cote cote-claire">&copy; {annee} {MARQUE}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {NAV_LEGAL.map((l) => (
          <li><a href={l.href} class="cote cote-claire transition-colors hover:text-tirage-clair">{l.libelle}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
