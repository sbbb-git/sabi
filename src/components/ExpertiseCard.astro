---
interface Props {
  titre: string;
  phrase: string;
  rang?: number;
  href?: string;
  niveau?: 2 | 3;
}

const { titre, phrase, rang, href, niveau = 3 } = Astro.props;
const Balise = href ? 'a' : 'div';
const Titre = `h${niveau}` as 'h2' | 'h3';
---

<Balise
  href={href}
  class:list={[
    'reveal group relative flex h-full flex-col bg-ivoire p-8 lg:p-10',
    href && 'transition-colors duration-200 hover:bg-creme',
  ]}
>
  {
    rang !== undefined && (
      <span class="chiffre text-[1.75rem] text-bronze">{String(rang).padStart(2, '0')}</span>
    )
  }
  <Titre
    class:list={[
      'font-titre text-[1.5rem] leading-[1.2] tracking-[-0.01em] text-nuit lg:text-[1.75rem]',
      rang !== undefined && 'mt-6',
    ]}
  >
    {titre}
  </Titre>
  <p class="mt-4 max-w-[38ch] text-corps text-texte">{phrase}</p>
  <slot />
</Balise>
