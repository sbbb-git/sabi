---
import Wordmark from './Wordmark.astro';
import { CONTACT, MARQUE, NAV, NAV_LEGAL } from '../consts';

const annee = new Date().getFullYear();
---

<footer class="filet-sombre bg-nuit text-blanc">
  <div class="conteneur">
    <div class="grid gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
      <div class="lg:col-span-5">
        <p class="text-[2rem] leading-none"><Wordmark /></p>
        <p class="mt-5 max-w-[32ch] text-corps text-sur-nuit">
          Structurer et financer la croissance.
        </p>
      </div>

      <nav class="lg:col-span-3" aria-label="Navigation de pied de page">
        <p class="surtitre surtitre-sombre">Navigation</p>
        <ul class="mt-5 space-y-3">
          {
            NAV.map((lien) => (
              <li>
                <a
                  href={lien.href}
                  class="text-corps text-blanc transition-colors duration-150 hover:text-sable"
                >
                  {lien.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <p class="surtitre surtitre-sombre">Contact</p>
        <ul class="mt-5 space-y-3">
          <li>
            <a
              href={`mailto:${CONTACT.email}`}
              class="text-corps text-blanc transition-colors duration-150 hover:text-sable"
            >
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${CONTACT.telephoneLien}`}
              class="text-corps text-blanc transition-colors duration-150 hover:text-sable"
            >
              {CONTACT.telephone}
            </a>
          </li>
          <li>
            <a
              href={CONTACT.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-corps text-blanc transition-colors duration-150 hover:text-sable"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="filet-sombre flex flex-col gap-4 py-8 text-[0.9375rem] text-sur-nuit sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {annee} {MARQUE}. Tous droits réservés.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          NAV_LEGAL.map((lien) => (
            <li>
              <a href={lien.href} class="transition-colors duration-150 hover:text-sable">
                {lien.libelle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
